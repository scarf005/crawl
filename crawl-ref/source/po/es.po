#. key: a glowing golden altar of the shining one
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a glowing golden altar of the shining one"
msgid ""
"An altar to the Shining One, made from the purest gold and almost blinding in\n"
"its radiance.\n"
msgstr ""
"Un altar de El Resplandeciente, hecho del oro más puro y de un resplandor que\n"
"casi ciega.\n"

#. key: a blossoming altar of fedhas
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a blossoming altar of fedhas"
msgid ""
"An altar to Fedhas Madash, covered in vibrant and colourful plant life.\n"
msgstr ""
"Un altar a Fedhas Madash, cubierto con vibrante y colorida vida vegetal.\n"

#. key: a candlelit altar of ignis
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a candlelit altar of ignis"
msgid ""
"An altar to Ignis, the Dying Flame. It's completely covered in candles of all\n"
"shapes and sizes, but only one remains alight, its slender flame wavering in the\n"
"slightest breeze.\n"
msgstr ""
"Un altar a Ignis el flama moriendo. Es cubierto con cirios de todas las formas y tamaños, pero solo uno permance encendido.\n"

#. key: a corrupted altar of lugonu
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a corrupted altar of lugonu"
msgid ""
"An altar to Lugonu the Unformed, possibly dedicated to some other power before\n"
"it was irrevocably corrupted.\n"
msgstr ""
"Un altar de Lugonu, posiblemente dedicado a algún otro poder antes de que fuera\n"
"corrompido irrevocablemente.\n"

#. key: a burning altar of makhleb
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a burning altar of makhleb"
msgid ""
"An ever-burning altar to Makhleb the Destroyer. Strange, twisting shapes are\n"
"visible in the flames.\n"
msgstr ""
"Un siempre ardiente altar de Makhleb el Destructor. Extrañas y retorcidas\n"
"formas se pueden ver en las llamas.\n"

#. key: a bloodstained altar of trog
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a bloodstained altar of trog"
msgid ""
"An altar to Trog the Wrathful, crudely made by what seem to be the hands of\n"
"giants and covered with bloodstains.\n"
msgstr ""
"Un altar a Trog el Colérico, burdamente hecho por lo que parecen ser manos de\n"
"gigantes y cubierto con marcas de sangre.\n"

#. key: a basalt altar of yredelemnul
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a basalt altar of yredelemnul"
msgid ""
"An altar to Yredelemnul the Dark, worked from columnar basalt.\n"
msgstr ""
"Un altar a Yredelemnul el Oscuro, labrado a partir de columnatas basálticas\n"

#. key: a glowing silver altar of zin
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a glowing silver altar of zin"
msgid ""
"An altar to Zin the Law-Giver, made from silver as pristine as Zin's followers\n"
"are expected to be, and glowing gently.\n"
msgstr ""
"Un altar a Zin, quien dio las Leyes, hecho de una plata tan prístina como se\n"
"espera que sean los seguidores de Zin, y brillando gentilmente.\n"

#. key: the floor
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:the floor"
msgid ""
"The floor.\n"
msgstr ""
"{{\n"
"    --Some of these lines may need to be broken up\n"
"    local descript = \"El piso.\"\n"
"    if you.in_branch(\"D\") then\n"
"        descript = descript .. \"\\nEstá hecho de roca lisa.\"\n"
"    elseif you.in_branch(\"Temple\") then\n"
"        descript = descript .. \"\\nHay musgo entredadera creciendo en lo.\"\n"
"    elseif you.in_branch(\"Orc\") then\n"
"        descript = descript .. \"\\nVes pepitas pequeñas en lo.\"\n"
"    elseif you.in_branch(\"Elf\") then\n"
"        descript = descript .. \"\\nTiene estampados místicos.\"\n"
"    elseif you.in_branch(\"Lair\") then\n"
"        descript = descript .. \"\\nTe sientes los cantos regosos debajo de tus pies.\"\n"
"    elseif you.in_branch(\"Swamp\") then\n"
"        if you.airborne() then\n"
"            descript = descript .. \"\\nPuedes ver el barro patanoso.\"\n"
"        else\n"
"            --TODO: Check if player is wearing boots or even has feet.\n"
"            descript = descript .. \"\\nPuedes sentir el barro patanoso en tus pies.\"\n"
"        end\n"
"    elseif you.in_branch(\"Shoals\") then\n"
"        descript = descript .. \"\\nPuedes oír el movimento de la arena debajo de tus pies.\"\n"
"    elseif you.in_branch(\"Snake\") then\n"
"        descript = descript .. \"\\nTiene estampados sinuosos.\"\n"
"    elseif you.in_branch(\"Spider\") then\n"
"        descript = descript .. \"\\nEn lo hay hilos finos -- y unos no-tan-finos -- de seda.\"\n"
"    elseif you.in_branch(\"Slime\") then\n"
"        descript = descript .. \"\\nEstá cubierto en baba.\"\n"
"    elseif you.in_branch(\"Vaults\") then\n"
"        descript = descript .. \"\\nHay salpicaduras de sangre en su superficie metálico.\"\n"
"    elseif you.in_branch(\"Crypt\") then\n"
"        descript = descript .. \"\\nComo el aire, su superficie es frio.\"\n"
"    --TODO: add descriptions for (the floors of) the rest of the branches (and sub-branches).\n"
"    --Branches: Depths, Zot, Bazaar, Volcano, Ice Cave, Necropolis, Tomb, Pan, Hells, probably more\n"
"    end\n"
"    return descript\n"
"}}\n"

#. key: a rock wall
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a rock wall"
msgid ""
"A wall consisting of simple rock.\n"
msgstr ""
"Una pared de roca sencilla.\n"

#. key: a granite statue
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a granite statue"
msgid ""
"A stone statue whose features have long since withered away.\n"
msgstr ""
"A pesar de la dureza de la piedra, los rasgos de esta estatua han desaparecido\n"
"hace tiempo.\n"

#. key: a dry fountain
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a dry fountain"
msgid ""
"A dried-up decorative fountain that has seen better days.\n"
msgstr ""
"Una fuente reseca que ha visto días mejores.\n"

#. key: a gate leading back out of this place
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a gate leading back out of this place"
msgid ""
"A gate that will let you return whence you came.\n"
msgstr ""
"Esta puerta te conduce de vuelta al calabozo.\n"

#. key: a gate leading to another region of pandemonium
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a gate leading to another region of pandemonium"
msgid ""
"A gate leading to yet another region of Pandemonium. There'll always be more.\n"
msgstr ""
"Esta puerta te lleva a otra región más del Pandemonio. Siempre habrán más.\n"

#. key: a gate to the realm of zot
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a gate to the realm of zot"
msgid ""
"A gate leading to the Realm of Zot.\n"
msgstr ""
"Esta puerta va al Reino de Zot.\n"

#. key: a gateway leading out of the abyss
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a gateway leading out of the abyss"
msgid ""
"A gateway out of the Abyss, shimmering and shifting in the impermanent\n"
"landscape.\n"
msgstr ""
"Un portal para salir de este maldito sitio, que palpita y se desliza en un\n"
"escenario siempre cambiante.\n"

#. key: a gateway to hell
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a gateway to hell"
msgid ""
"A gateway leading to the Vestibule of Hell. Few would go there voluntarily.\n"
msgstr ""
"Este portal lleva al Vestíbulo del Infierno. Pocos irían allí voluntariamente.\n"

#. key: a crawl-hole back to the lair
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a crawl-hole back to the lair"
msgid ""
"A passage leading back to the Lair of Beasts.\n"
msgstr ""
"Puedes usarlo para volver a un sitio menos estresante y con menos telarañas.\n"

#. key: a gate to the vaults
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a gate to the vaults"
msgid ""
"A gateway leading to the Vaults.\n"
msgstr ""
"Esta puetra va a las bóvedas. Ten cuidado porque no puedes salir sin una runa\n"
"de Zot, y la runa plata en el quinto piso está muy guardado.\n"

#. key: a closed door
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a closed door"
msgid ""
"A closed wooden door. All monsters that can wield equipment, and some of them\n"
"that can't, may open it again. If it is opened by a monster while it is aware\n"
"of you, it has a chance of breaking.\n"
msgstr ""
"Una puera de madera. Para abrirla, simplemente camina hacia ella, o usa 'O'\n"

#. key: a frozen archway
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a frozen archway"
msgid ""
"A portal leading to an ice cave. The archway is gradually melting away.\n"
msgstr ""
"Este portal te lleva a una cueva de hielo. Está derritiéndose lentamente.\n"

#. key: a glowing drain
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a glowing drain"
msgid ""
"A passage leading to a sewer. It is gradually rusting away.\n"
msgstr ""
"Este pasaje te te lleva a un alcantarillado. Está oxidándose lentamente.\n"

#. key: a magical portal
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a magical portal"
msgid ""
"A portal leading to a wizard's laboratory. It is fading away.\n"
msgstr ""
"Un portal a un laboratorio de un mago. Está desvaneciéndose\n"

#. key: a collapsed entrance
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a collapsed entrance"
msgid ""
"A collapsed passage which cannot be used anymore.\n"
msgstr ""
"Un pasaje colapsado que no se puede ser utilizado.\n"

#. key: a large window
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a large window"
msgid ""
"A window embedded in the side of an enormous metal pipe, allowing observation\n"
"of the water flowing inside.\n"
msgstr ""
"Una ventana empotrada en el lateral de una enorme tubería metálica, que permite\n"
"observar el flujo del agua en su interior.\n"

#. key: a gravestone
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a gravestone"
msgid ""
"A nameless grave.\n"
msgstr ""
"Una tumba sin un nombre.\n"

#. key: a dead tree
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a dead tree"
msgid ""
"The dry remains of a long-dead tree.\n"
msgstr ""
"Este árbol está tan muerto como todo lo demás aquí.\n"

#. key: a golden statue
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a golden statue"
msgid ""
"A solid gold statue of a saint.\n"
msgstr ""
"Una estatua de oro macizo de un santo.\n"

#. key: a heavily etched metal wall
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a heavily etched metal wall"
msgid ""
"A metal wall etched with murals depicting, in great and gruesome detail,\n"
"exactly what will be done to anyone caught stealing from the Vaults.\n"
msgstr ""
"Esta pared de metal está grabada con murales que representan, con horripilante\n"
"detalle, lo que le ocurrirá a cualquiera que sea descubierto intentando robar\n"
"de las Cámaras. Verlo, te provoca nauseas.\n"

#. key: a heavily etched crystal wall
#: dat/descript/features.txt
msgctxt ""
"textdb:descriptions:a heavily etched crystal wall"
msgid ""
"A crystal wall etched with murals depicting, in great and gruesome detail,\n"
"exactly what will be done to anyone caught stealing from the Vaults.\n"
msgstr ""
"Esta pared de cristal verdoso está grabada con murales que representan, con\n"
"horripilante detalle, lo que le ocurrirá a cualquiera que sea descubierto\n"
"intentando robar de las Cámaras. Verlo, te provoca nauseas.\n"

#. key: amulet of nothing
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:amulet of nothing"
msgid ""
"An amulet with no special properties.\n"
msgstr ""
"Un amuleto sin características especiales.\n"

#. key: animal skin
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:animal skin"
msgid ""
"A large piece of thick skin covered in fur, cut from the corpse of an animal\n"
"and worn as a primitive garment. It offers rudimentary protection against harm,\n"
"but, having never been tanned, it carries a light stench of rotting flesh.\n"
msgstr ""
"La piel de un animal.\n"

#. key: baked corpse
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:baked corpse"
msgid ""
"A baked corpse. Warm, useless, and dead.\n"
msgstr ""
"Un cadáver horneado. Tibia, muerte y inútil\n"

#. key: bardiche
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:bardiche"
msgid ""
"A long pole with an enormous, cleaving blade on one end.\n"
msgstr ""
"Una larga garrocha con una enorme cuchilla en uno de sus extremos.\n"

#. key: book of annihilations
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of annihilations"
msgid ""
"A tome of arcane fury, greatly sought after by sorcerers. It allows the gifted\n"
"and resourceful to conjure destruction with ease.\n"
msgstr ""
"Las andrajosas páginas de este libro rezuman sangre. Incluso un analfabeto\n"
"puede sentir el diáfano impacto de la furia arcana contenida en el libro. Es\n"
"codiciado por los brujos, ya que le permite al dotado e ingenioso ordenar la\n"
"destrucción con un simple chasquido de los dedos. Sin embargo, los magos más\n"
"endebles podrían encontrar su perdición al intentar leer este opus.\n"

#. key: book of cantrips
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of cantrips"
msgid ""
"A book containing a small selection of very basic magic spells, intended for\n"
"beginners who wish to learn the rudiments of one of the featured magical\n"
"schools.\n"
msgstr ""
"Un libro con hechizos mágicos.\n"

#. key: book of conjurations
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of conjurations"
msgid ""
"A book containing an introduction to the destructive magical arts of\n"
"Conjurations.\n"
msgstr ""
"Un libro que contiene una introdución a las artes destructivos de las Conjuraciones.\n"

#. key: book of debilitation
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of debilitation"
msgid ""
"A spellbook containing spells known for having a particularly unpleasant\n"
"effect on their victims. It's considered something of a faux pas in the\n"
"wizarding community to be seen with this book in one's collection.\n"
msgstr ""
"Un libro con hechizos mágicos.\n"

#. key: book of dreams
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of dreams"
msgid ""
"The somniloquent utterings of a famed mystic, using uniquely bizarre imagery\n"
"and cryptic digressions to describe spells drawn from the mystic's visions.\n"
msgstr ""
"Un libro transparente. La luz se refleja de una forma extraña sobre su\n"
"superficie.\n"

#. key: book of fixed level
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of fixed level"
msgid ""
"A book of magic spells.\n"
msgstr ""
"Un libro con hechizos mágicos.\n"

#. key: book of fixed theme
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of fixed theme"
msgid ""
"A book of magic spells.\n"
msgstr ""
"Un libro con hechizos mágicos.\n"

#. key: book of geomancy
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of geomancy"
msgid ""
"A book containing basic spells involving the element of Earth. Readers are\n"
"recommended to wear a pair of gardening gloves.\n"
msgstr ""
"Un libro con hechizos sencillos que implican el elemento Tierra. Lectores deben\n"
"llevar guantes de jardinería cuando leyéndolo.\n"

#. key: book of hexes
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of hexes"
msgid ""
"A spellbook containing an assortment of powerful Hexes, which sparkles and\n"
"shimmers as the pages are flipped.\n"
msgstr ""
"Un libro con hechizos mágicos.\n"

#. key: book of necromancy
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of necromancy"
msgid ""
"A macabre book containing basic Necromancy spells. Readers are recommended to\n"
"wear a pair of gloves they don't mind disposing of afterward.\n"
msgstr ""
"Un polvoriento tomo de magia prohibida.\n"

#. key: book of power
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of power"
msgid ""
"A book of powerful and destructive magic spells, rumbling and shuddering with\n"
"barely-contained energies.\n"
msgstr ""
"Un libro con hechizos mágicos.\n"

#. key: book of spatial translocations
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of spatial translocations"
msgid ""
"A basic spellbook on the magical field of Translocations. Many would-be mages\n"
"have seen it disappear just as they needed it most.\n"
msgstr ""
"Un libro con hechizos mágicos.\n"

#. key: book of the warp
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of the warp"
msgid ""
"A book of advanced Translocations spells, written by a particularly\n"
"misanthropic mage. After its completion, they were never seen again, which may\n"
"or may not have been the point.\n"
msgstr ""
"Un libro con hechizos mágicos.\n"

#. key: book of unlife
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:book of unlife"
msgid ""
"An unholy book describing a variety of magical methods for the creation and\n"
"command of undead servants.\n"
msgstr ""
"Un libro con hechizos mágicos. Esta lleno de símbolos para contactar con los\n"
"muertos.\n"

#. key: buckler
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:buckler"
msgid ""
"A small piece of wood and metal, to be strapped on one arm for defence.\n"
msgstr ""
"Un pequeño escudo.\n"

#. key: chain mail
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:chain mail"
msgid ""
"A suit of armour made entirely out of tiny metal rings.\n"
msgstr ""
"Una malla de anillos metálicos entrelazados.\n"

#. key: cloak
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:cloak"
msgid ""
"A cloth cloak.\n"
msgstr ""
"Una capa de tela.\n"

#. key: corpse
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:corpse"
msgid ""
"A corpse. Useless and dead.\n"
msgstr ""
"Un cadáver. Muerte y inútil.\n"

#. key: crystal plate armour
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:crystal plate armour"
msgid ""
"An incredibly heavy but extremely effective suit of crystalline armour.\n"
msgstr ""
"Una armadura de cristal, increíblemente pesada, pero extremadamente efectiva.\n"

#. key: decaying skeleton
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:decaying skeleton"
msgid ""
"A decaying skeleton.\n"
msgstr ""
"Un esqueleto en descomposición.\n"

#. key: demon blade
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:demon blade"
msgid ""
"A terrible weapon, forged in the fires of Hell.\n"
msgstr ""
"Un arma terrible, forjada en las llamas del Infierno.\n"

#. key: demon trident
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:demon trident"
msgid ""
"A terrible three-pronged weapon, moulded by fire and brimstone.\n"
msgstr ""
"Un arma terrible, moldeada por el fuego y el azufre.\n"

#. key: demon whip
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:demon whip"
msgid ""
"A terrible weapon, woven in the depths of the inferno.\n"
msgstr ""
"Un arma terrible, fabricada en las profundidades del Hades.\n"

#. key: eudemon blade
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:eudemon blade"
msgid ""
"A sacred blade from the forges of Heaven, inhabited by a good spirit. It is a\n"
"favoured weapon of the Shining One's servants.\n"
msgstr ""
"Una gloriosa cuchilla creada en los forjas del Cielo, y poseída por un espíritu\n"
"benigno. Es una de las armas preferidas de los sirvientes de El\n"
"Resplandeciente.\n"

#. key: eveningstar
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:eveningstar"
msgid ""
"The opposite of a morningstar. A balanced mace with a long shaft and a metal\n"
"head covered in lethal spikes.\n"
msgstr ""
"Lo contrario del lucero del alba.\n"

#. key: fire dragon scales
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:fire dragon scales"
msgid ""
"The scales of a fire-breathing dragon. It provides great protection from fire,\n"
"while rendering its wearer more susceptible to cold.\n"
msgstr ""
"Una armadura mágica confeccionada a partir de las escamas de un dragón que\n"
"exhalaba fuego. Proporciona gran protección contra los efectos del fuego, pero\n"
"hace a su usuario más vulnerable a los efectos del frío.\n"

#. key: giant spiked club
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:giant spiked club"
msgid ""
"A giant lump of wood with sharp spikes at one end.\n"
msgstr ""
"Un gigantesco trozo de madera, con púas en uno de sus extremos.\n"

#. key: glaive
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:glaive"
msgid ""
"A pole with a large, heavy blade on one end.\n"
msgstr ""
"Una garrocha con una enorme y pesada cuchilla en su extremo.\n"

#. key: golden dragon scales
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:golden dragon scales"
msgid ""
"The scales of a golden dragon. It is much heavier than most dragon scale\n"
"armours, and grants its wearer resistance to poison, fire and cold.\n"
msgstr ""
"Una armadura mágica elaborada a partir de las escamas de un dragón dorado. Es\n"
"muy pesado y aparatoso, pero proporciona gran protección contra el fuego, el\n"
"frío, y el veneno.\n"

#. key: gold piece
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:gold piece"
msgid ""
"A pile of glittering gold coins.\n"
msgstr ""
"Una montón de brillantes monedas de oro.\n"

#. key: great mace
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:great mace"
msgid ""
"An enormous metal war club, of great cumbrousness.\n"
msgstr ""
"Una enorme y pesada maza.\n"

#. key: helmet
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:helmet"
msgid ""
"A piece of metal headgear.\n"
msgstr ""
"Una protección metálica para la cabeza.\n"

#. key: sling
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:sling"
msgid ""
"A piece of cloth and leather for launching stones, adequate for hunting small\n"
"game like rabbits or goblins.\n"
msgstr ""
"Un pedazo de tela y cuero para lanzar piedras, que pueden hacer algo de daño al\n"
"impactar. A diferencia de otros lanzadores, llevar un escudo no hace más lenta\n"
"la tasa de disparos.\n"

#. key: ice dragon scales
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ice dragon scales"
msgid ""
"The scales of a cold-breathing dragon. It provides great protection from cold,\n"
"while rendering its wearer more susceptible to fire.\n"
msgstr ""
"Una armadura de las escamas de un dragón de hielo. Te da gran protección contra los efectos del\n"
"frío, aunque a costa de hacerte más vulnerable a los efectos del fuego.\n"

#. key: javelin
#. Preserve {{ lua }} delimiters exactly.
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:javelin"
msgid ""
"A lightweight spear, designed for throwing. It will pass through the targets it\n"
"hits, potentially hitting all targets in its path until it reaches maximum\n"
"range.\n"
"{{\n"
"    if you.race() == \"Kobold\" or you.race() == \"Spriggan\" then\n"
"        return \"Unfortunately, it is too long and awkward for you to use.\"\n"
"    end\n"
"}}\n"
msgstr ""
"Una larga y ligera vara que puede ser lanzada con la mano. {{\n"
"    if you.race() == \"Halfling\"\n"
"        or you.race() == \"Kobold\"\n"
"        or you.race() == \"Spriggan\"\n"
"    then\n"
"        return \"Por desgracia, es demasiada larga y rara para ti, así que eres\n"
"incapaz de usarla.\"\n"
"    else\n"
"        return \"\"\n"
"    end\n"
"}}\n"

#. key: kite shield
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:kite shield"
msgid ""
"A piece of wood and metal, to be strapped on one arm for defence.\n"
msgstr ""
"Una pieza de metal diseñada para llevarse atada en un brazo. Es pesada de\n"
"llevar y hace algo más lenta la velocidad a la que se puede atacar.\n"

#. key: lajatang
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:lajatang"
msgid ""
"A very rare and extremely effective weapon, featuring a pole with half-moon\n"
"blades at both ends.\n"
msgstr ""
"Una exótica y muy efectiva arma de importación. Consiste en una garrocha, con\n"
"cuchillas en forma de media luna en ambos extremos.\n"

#. key: large rock
#. Preserve {{ lua }} delimiters exactly.
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:large rock"
msgid ""
"A very large and very heavy stone. {{\n"
"    if you.race() == \"Ogre\"\n"
"       or you.race() == \"Troll\"\n"
"   then\n"
"       return \"\"\n"
"   else\n"
"       return \"Only large creatures are capable of throwing it.\"\n"
"   end\n"
"}}\n"
msgstr ""
"Un piedra, usada por los gigantes como proyectil. {{\n"
"    if you.race() == \"Ogre\"\n"
"       or you.race() == \"Troll\"\n"
"       or you.race() == \"Formicid\"\n"
"    then\n"
"        return \"\"\n"
"    else\n"
"        return \"Por desgracia, es demasiado grande y pesada para ti, así que\n"
"eres incapaz de usarla.\"\n"
"    end\n"
"}}\n"

#. key: leather armour
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:leather armour"
msgid ""
"A suit made from layers of tanned animal hide. It provides basic protection\n"
"with almost no hindrance to spellcasting or stealthy movement.\n"
msgstr ""
"Una armadura de cuero endurecido.\n"

#. key: longbow
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:longbow"
msgid ""
"A long, strong bow made of yew.\n"
msgstr ""
"Un largo y fuerte arco hecho de madera de tejo. Es capaz de hacer un daño\n"
"excelente en combate y un arquero experimentado puede usarlo muy eficazmente.\n"

#. key: orb of zot
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:orb of zot"
msgid ""
"An invaluable artefact. Once you have escaped to the surface with it, your\n"
"quest is complete.\n"
msgstr ""
"Una vez que llegues a la superficie con este artilugio de valor incalculable,\n"
"habrás completado tu misión.\n"

#. key: pair of boots
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:pair of boots"
msgid ""
"A pair of boots. They are worn on the feet, and cover all but the largest\n"
"hooves and talons.\n"
msgstr ""
"Un par de botas.\n"

#. key: pair of gloves
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:pair of gloves"
msgid ""
"A pair of gloves. They are worn on the hands, and cover all but the largest\n"
"claws.\n"
msgstr ""
"Un par de guantes.\n"

#. key: pearl dragon scales
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:pearl dragon scales"
msgid ""
"The nacreous scales of a pearl dragon. It grants its wearer resistance to\n"
"negative energies.\n"
msgstr ""
"Una armadura mágica elaborada a partir de las fuertes y flexibles escamas de un\n"
"dragón nacarado. Proporciona protección contra la energía negativa.\n"

#. key: potion of berserk rage
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:potion of berserk rage"
msgid ""
"A potion which can send one into an incoherent rage, granting them a great but\n"
"temporary increase to their health, damage, and speed. In exchange, their mind\n"
"is clouded by anger, only allowing them to move and attack in melee. The rage\n"
"will wear off quickly if they do not attack monsters, and upon expiry, the\n"
"imbiber will be fatigued, causing them to slow dramatically and rendering them\n"
"unable to berserk again for a short duration.\n"
msgstr ""
"Una poción que permite entrar en un estado de trance berserk.\n"

#. key: potion of blood
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:potion of blood"
msgid ""
"A potion containing the essence of life.\n"
msgstr ""
"Una poción que contiene la esencia de la vida. Es vital para todos los seres\n"
"vivos, al igual que para algunos no-muertos. Puede proporcionar nutrición para\n"
"los que puedan alimentarse de carne.\n"

#. key: potion of brilliance
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:potion of brilliance"
msgid ""
"A potion which increases the power of the drinker's spells and halves their\n"
"magic cost (rounding up).\n"
msgstr ""
"Una poción mágica que aumenta en gran cantidad la inteligencia y el mana de\n"
"aquél que la beba.\n"

#. key: potion of experience
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:potion of experience"
msgid ""
"A truly wonderful and very rare drink, which grants experience when consumed.\n"
msgstr ""
"Una bebida rarísima y verdaderamente maravillosa.\n"

#. key: potion of invisibility
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:potion of invisibility"
msgid ""
"A potion which confers invisibility on one who consumes it.\n"
msgstr ""
"Una poción que te oculta de la vista de los demás.\n"

#. key: potion of might
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:potion of might"
msgid ""
"A potion which greatly increases the power of the drinker's melee attacks.\n"
msgstr ""
"Una poción mágica que incrementa en gran cantidad la fuerza y la capacidad\n"
"física de quien la beba.\n"

#. key: potion of mutation
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:potion of mutation"
msgid ""
"A potion which mutates the drinker, removing several mutations then\n"
"granting a few random mutations, which are likely (but not guaranteed) to be\n"
"beneficial.\n"
msgstr ""
"Una poción que te provoca cosas muy extrañas.\n"

#. key: potion of resistance
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:potion of resistance"
msgid ""
"A potion which grants temporary resistance to a variety of harmful effects:\n"
"fire, cold, electricity, poison, and acid.\n"
msgstr ""
"Una poción que te da temporalmente resistencia a los elementos y al veneno.\n"

#. key: quad damage
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:quad damage"
msgid ""
"A mysterious item resembling a rune of some kind. Once evoked, it will make the\n"
"user glow blue and add a reverb to all sound... and there may be other effects\n"
"as well.\n"
msgstr ""
"Un objeto misterioso semejante a una runa de algún tipo. Una vez se evoque,\n"
"hará que el usuario brille azul y añada reverberaciones a cualquier sonido... y\n"
"puede haber otros efectos además.\n"

#. key: quarterstaff
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:quarterstaff"
msgid ""
"A sturdy wooden pole, meant for fighting.\n"
msgstr ""
"Un robusto palo de madera, empleado para el combate.\n"

#. key: ring of dexterity
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ring of dexterity"
msgid ""
"A ring that increases the dexterity of its wearer.\n"
msgstr ""
"Este anillo aumenta o reduce la destreza de su portador, dependiendo de en qué\n"
"grado ha sido encantado.\n"

#. key: ring of evasion
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ring of evasion"
msgid ""
"A ring that makes its wearer more capable of avoiding attacks.\n"
msgstr ""
"Este anillo hace que su portador sea más o menos capaz de evitar ataques, en\n"
"función de su grado de encantamiento.\n"

#. key: ring of intelligence
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ring of intelligence"
msgid ""
"A ring that increases the intelligence of its wearer.\n"
msgstr ""
"Este anillo aumenta o reduce la habilidad mental de su portador, en función de\n"
"su grado de encantamiento.\n"

#. key: ring of magical power
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ring of magical power"
msgid ""
"A ring that increases its wearer's reserves of magical power for so long as it\n"
"is worn.\n"
msgstr ""
"Este anillo incrementa las reservas mágicas de su portador.\n"

#. key: ring of poison resistance
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ring of poison resistance"
msgid ""
"A ring that protects its wearer from poison.\n"
msgstr ""
"Este anillo proporciona protección ante los efectos de los venenos.\n"

#. key: ring of protection
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ring of protection"
msgid ""
"A ring that protects its wearer from most sources of damage.\n"
msgstr ""
"Este anillo bien protege a su portador del daño o bien le hace más vulnerable,\n"
"en función de su grado de encantamiento.\n"

#. key: ring of protection from cold
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ring of protection from cold"
msgid ""
"A ring that protects its wearer from cold.\n"
msgstr ""
"Este anillo protege del frío.\n"

#. key: ring of protection from fire
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ring of protection from fire"
msgid ""
"A ring that protects its wearer from fire.\n"
msgstr ""
"Este anillo protege del fuego\n"

#. key: ring of see invisible
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ring of see invisible"
msgid ""
"A ring that allows its wearer to see invisible things.\n"
msgstr ""
"Este anillo le permita a su portador ver aquellas cosas que la magia ha\n"
"ocultado.\n"

#. key: ring of strength
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ring of strength"
msgid ""
"A ring that increases the strength of its wearer.\n"
msgstr ""
"Este anillo aumenta o disminuye la fuerza física de su portador, en un grado\n"
"que depende de su poder.\n"

#. key: ring of wizardry
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:ring of wizardry"
msgid ""
"A ring that increases the success rate of its wearer's magical spells.\n"
msgstr ""
"Este anillo incrementa la habilidad de su portador para usar hechizos mágicos.\n"

#. key: rune of zot
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:rune of zot"
msgid ""
"A charm which allows entry into the Realm of Zot.\n"
msgstr ""
"Un talismán que permite la entrada a los dominios de Zot.\n"

#. key: sacred scourge
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:sacred scourge"
msgid ""
"A blessed weapon, woven by the saints in Heaven and hated by the unholy. It is\n"
"a favoured weapon of the Shining One's servants.\n"
msgstr ""
"Una arma bendita, tejida por los santos en el cielo y odiado por lo impío. Es\n"
"el arma favorita de los sirvientes de El Resplandeciente.\n"

#. key: scale mail
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:scale mail"
msgid ""
"A leather suit covered with metal plates attached to each other in overlapping\n"
"rows to provide full protection, but at the cost of reduced freedom of\n"
"movement.\n"
msgstr ""
"Un traje de cuero cubierto con placas de metal unidas y superpuestas entre sí\n"
"para proveer protección total, pero a costa de una reducida libertad de\n"
"movimiento.\n"

#. key: scroll of acquirement
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:scroll of acquirement"
msgid ""
"A wonderful scroll which causes the creation of a valuable item, with the\n"
"reader choosing from a small selection. The items offered will often be a\n"
"good match for the reader's skills; and if nothing recommends itself, the\n"
"reader can always choose a heap of gold.\n"
msgstr ""
"Este gran pergamino es capaz de crear un objeto. Quien lo use, deberá elegir el\n"
"tipo de objeto que quiera crear.\n"

#. key: scroll of amnesia
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:scroll of amnesia"
msgid ""
"A scroll that allows its reader to selectively erase one spell from memory to\n"
"recapture the magical energy bound up with it.\n"
msgstr ""
"Este pergamino permite al lector borrar de forma selectiva uno de los hechizos\n"
"de su memoria para recapturar la energía mágica asociada a él.\n"

#. key: scroll of blinking
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:scroll of blinking"
msgid ""
"A scroll that allows its reader to teleport a short distance, with precise\n"
"control.\n"
msgstr ""
"Este pergamino permite al lector teleportarse a una distancia corta, con un\n"
"control preciso.\n"

#. key: scroll of fear
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:scroll of fear"
msgid ""
"A scroll that causes great fear in nearby foes, causing them to flee until\n"
"attacked, cornered, or enough time has passed.\n"
"\n"
"Non-living, undead and plant monsters cannot be feared, and berserk or frenzied\n"
"monsters are also immune.\n"
msgstr ""
"Este pergamino causa un gran temor a aquellos que están viendo al lector.\n"

#. key: scroll of fog
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:scroll of fog"
msgid ""
"A scroll that surrounds the reader with a dense cloud of fog, which can block\n"
"vision temporarily. The fog takes a short time to fully spill out.\n"
msgstr ""
"Este pergamino rodea al lector con una densa nube de niebla.\n"

#. key: scroll of identify
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:scroll of identify"
msgid ""
"A useful magic scroll which identifies the properties of any unknown object.\n"
msgstr ""
"Este útil pergamino mágico permite determinar las propiedades mágicas de\n"
"cualquier objeto, y ocasionalmente permitirá múltiples identificaciones.\n"
"\n"
"Si es usado en un mazo de cartas, este pergamino revelará la carta superior.\n"

#. key: scroll of revelation
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:scroll of revelation"
msgid ""
"A scroll that reveals its reader's surroundings. The layout of the current\n"
"floor is fully mapped, and everything within a moderate radius, including\n"
"both visible and invisible monsters, is momentarily shown.\n"
msgstr ""
"Este pergamino revela los alrededores del lector. El piso actual está mapeado, y\n"
"todo dentro de una distancia moderada, incluyendo visible e invisible monstruos,\n"
"está revelado por un momento.\n"

#. key: scroll of teleportation
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:scroll of teleportation"
msgid ""
"A scroll that translocates the reader to a random position after a short delay.\n"
"Reading this scroll while waiting for a teleportation will instead cancel it.\n"
msgstr ""
"Cuando leas este pergamino seras transportado a un lugar aleatorio tras esperar\n"
"un poco.\n"

#. key: scythe
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:scythe"
msgid ""
"A farm implement, usually only used by untrained mobs in combat. In practice,\n"
"it's quite similar to a halberd.\n"
msgstr ""
"Un ápero de granja, normalmente no apto para el combate.\n"

#. key: staff of conjuration
#: dat/descript/items.txt
msgctxt ""
"textdb:descriptions:staff of conjuration"
msgid ""
"A staff that increases the power of conjurations cast by its wielder. If the\n"
"wielder is skilled in Evocations and Conjurations, they can blast those they\n"
"strike with pure energy.\n"
msgstr ""
"Este bastón aumenta el poder de los conjuros lanzados por su portador.\n"

#. key: amulet
#: dat/descript/unident.txt
msgctxt ""
"textdb:descriptions:amulet"
msgid ""
"An amulet to be worn as jewellery around the neck, charged with arcane powers\n"
"of unknown provenance.\n"
msgstr ""
"Un talismán para llevar puesto al cuello, cargado con poderes arcanos de origen\n"
"desconocido.\n"

#. key: book
#: dat/descript/unident.txt
msgctxt ""
"textdb:descriptions:book"
msgid ""
"An arcane textbook containing magical spells of unknown origin.\n"
msgstr ""
"Un libro que contiene hechizos mágicos de origen desconocido.\n"

#. key: potion
#: dat/descript/unident.txt
msgctxt ""
"textdb:descriptions:potion"
msgid ""
"An unlabelled flask containing a single dose of unknown liquid.\n"
msgstr ""
"Una pequeña botella llena de líquido.\n"

#. key: ring
#: dat/descript/unident.txt
msgctxt ""
"textdb:descriptions:ring"
msgid ""
"A ring charged with arcane forces of unknown provenance, to be worn as jewellery\n"
"on a finger.\n"
msgstr ""
"Un talismán cargado con fuerzas arcanas de origen desconocido, pensado para\n"
"llevarlo puesto como anillo en un dedo.\n"

#. key: scroll
#: dat/descript/unident.txt
msgctxt ""
"textdb:descriptions:scroll"
msgid ""
"A disposable arcane formula inscribed on parchment by a professional scribe or\n"
"sorcerer. Anyone can evoke the power of the arcane formula by reading it out\n"
"loud, but the nature of that power is not a priori apparent.\n"
msgstr ""
"Un rollo de papel cubierto de escritos mágicos.\n"

#. key: staff
#: dat/descript/unident.txt
msgctxt ""
"textdb:descriptions:staff"
msgid ""
"A staff improved with arcane powers of unknown nature.\n"
msgstr ""
"Una vara con propiedades mágicas.\n"

#. key: wand
#: dat/descript/unident.txt
msgctxt ""
"textdb:descriptions:wand"
msgid ""
"An unusually magical sort of stick.\n"
msgstr ""
"Una vara. Quizás sea mágica.\n"

#. key: singing sword
#: dat/descript/unrand.txt
msgctxt ""
"textdb:descriptions:singing sword"
msgid ""
"An enchanted blade which loves nothing more than to sing to its owner, whether\n"
"they want it to or not.\n"
msgstr ""
"Una espada encantada que le encanta cantar a su manipulador, le gusta o no.\n"

#. key: mace of variability
#: dat/descript/unrand.txt
msgctxt ""
"textdb:descriptions:mace of variability"
msgid ""
"A large mace said to have appeared when Xom grew bored with the predictability\n"
"of more ordinary instruments of chaos.\n"
msgstr ""
"Es bastante poco fiable.\n"

#. key: dagger "morg"
#: dat/descript/unrand.txt
msgctxt ""
"textdb:descriptions:dagger \"morg\""
msgid ""
"An ugly rusty dagger. Many years ago it was the property of a powerful mage\n"
"called Boris. He got lost in the Dungeon while seeking the Orb.\n"
msgstr ""
"Una daga fea y oxidada. Hace muchas años fue de un mago poderoso llamado Boris,\n"
"pero se perdío cuando buscando el Orbe.\n"

#. key: giant club "skullcrusher"
#: dat/descript/unrand.txt
msgctxt ""
"textdb:descriptions:giant club \"skullcrusher\""
msgid ""
"A massive enchanted cudgel that augments the already considerable strength of\n"
"anyone mighty enough to wield it.\n"
msgstr ""
"Un garrote gigante y encantado que augmenta la ya considerable fuerza de\n"
"cualquiera que tiene la fuerza para empuñarlo.\n"

#. key: gauntlets of war
#: dat/descript/unrand.txt
msgctxt ""
"textdb:descriptions:gauntlets of war"
msgid ""
"A pair of thick steel gauntlets. They were Okawaru's reward for a mighty\n"
"warlord. The owner is destined to die in battle, but what a death it will be!\n"
msgstr ""
"Un par de guanteletes gruseos, hechos de acero de calidad. Fueron un regalo de\n"
"Okwaru a un caudillo militar poderoso. Su dueño morirá en batalla, ¡pero que una\n"
"muerte será!\n"

#. key: maxwell's patent armour
#: dat/descript/unrand.txt
msgctxt ""
"textdb:descriptions:maxwell's patent armour"
msgid ""
"A suit of armour created by the famous inventor Maxwell, providing unparalleled\n"
"protective qualities at a very affordable price. His unorthodox materials left\n"
"it with certain shortcomings, but he's yet to have anyone come back for a\n"
"refund.\n"
msgstr ""
"Una armadura de aspecto extraño.\n"

#. key: robe of night
#: dat/descript/unrand.txt
msgctxt ""
"textdb:descriptions:robe of night"
msgid ""
"A long black robe made of strange glossy material. It shrouds its wearer in\n"
"darkness, reducing the range of vision. According to legend, it was the gift\n"
"of Rutra, a renowned demigoddess of the night, to one of her followers.\n"
msgstr ""
"Una toga negra y larga hecha de un material raro y lusturoso. Envuelve el que lo\n"
"lleva en oscuro, reduciendo la visión. Según leyenda fue un regalo de Ratri la\n"
"Diosa de la Noche a uno de sus discípulos.\n"

#. key: fencer's gloves
#: dat/descript/unrand.txt
msgctxt ""
"textdb:descriptions:fencer's gloves"
msgid ""
"A pair of gloves made of white silk.\n"
msgstr ""
"Un par de guantes hechos de seda blanca.\n"

#. key: amulet of tranquility
#: dat/descript/unrand.txt
msgctxt ""
"textdb:descriptions:amulet of tranquility"
msgid ""
"A pendant made of purest jade. It grants its wearer immense willpower and\n"
"mental fortitude.\n"
msgstr ""
"Un dije del jade más fino. Da el que lo lleva fuerza de voluntad y fortaleza mental\n"
"sin igual.\n"

#. key: amulet of elemental vulnerability
#: dat/descript/unrand.txt
msgctxt ""
"textdb:descriptions:amulet of elemental vulnerability"
msgid ""
"A blue-steel amulet. Its creator, an exceedingly practical woman, designed it to\n"
"provide powerful protection against mundane jabs, stabs and bites. It's worse than\n"
"useless against fire and frost, but how often does anyone really need to worry\n"
"about that?\n"
msgstr ""
"Un dije de acero azúl con quemaduras borrosas. Su creadora, una mujer muy sensata,\n"
"lo diseñó para proteger contra puñaladas, puñetazos y mordeduras. Es peor que\n"
"inútil contra fuego y escaracha, ¿pero con cuánta frequencia es eso relevante?\n"

#. key: __(_suffix_examine
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:__(_suffix_examine"
msgid ""
"It has been enchanted to dance through the air and attack under its own power.\n"
msgstr ""
"Ha sido encantada para que dance en el aire y pueda atacar por su cuenta.\n"

#. key: aizul
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:aizul"
msgid ""
"Once the primary guardian serpent of a legendary treasure hoard, she was\n"
"disgraced after thieves looted it while she slept. She seeks to make up for her\n"
"failure by protecting the only treasure the villains overlooked, a single\n"
"precious talisman.\n"
msgstr ""
"En una ocasión fue la principal serpiente guardiana de un legendario tesoro,\n"
"pero cayó en desgracia al saquear unos ladrones el tesoro mientras que dormía.\n"
"Ahora se desliza por el calabozo buscando venganza contra cualquier aspirante a\n"
"saqueador. Es un consumado hechicero, pero en el combate cuerpo a cuerpo no es\n"
"más peligroso que otros de su misma especie.\n"

#. key: asmodeus
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:asmodeus"
msgid ""
"Greatest and most cunning of the Lords of Hell, Asmodeus was born when the twin\n"
"fires of greed and treachery first sparked to life within a mortal's heart.\n"
"His hideous body is perpetually wreathed in flame.\n"
msgstr ""
"Uno de los archi-demonios que moran las profundidades del Infierno, envuelto en\n"
"fuego.\n"

#. key: azrael
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:azrael"
msgid ""
"A powerful, belligerent efreet. (Is there any other kind?)\n"
msgstr ""
"Un potente y beligerante Ifrit. (¿Acaso los hay de otra clase?)\n"

#. key: boris
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:boris"
msgid ""
"An ancient and powerful lich. Like all true liches, Boris is immortal, and will\n"
"regenerate his desiccated skeletal remains even if completely disintegrated.\n"
"The same cannot be said for his many victims over his many centuries, from\n"
"which he collects and channels their dying woes and regrets.\n"
msgstr ""
"Un antiquísimo lich. El aire alrededor de su sombría figura chisporrotea\n"
"energía maligna.\n"

#. key: cerebov
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:cerebov"
msgid ""
"A violent and wrathful demon, Cerebov appears as a giant humanoid covered in\n"
"shining golden armour and wielding a huge twisted sword.\n"
msgstr ""
"Un violento y furibundo demonio, Cerebov aparece como un gigantesco humano\n"
"cubierto por una resplandeciente armadura dorada y empuñando una enorme espada\n"
"retorcida.\n"

#. key: chuck
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:chuck"
msgid ""
"Chuck the stone giant loves rocks, the bigger the better! Over the years, he\n"
"has managed to amass quite the collection, including some rare, enchanted ones.\n"
msgstr ""
"A Chuck, el gigante de piedra, le encantan las rocas. ¡Mientras más grandes,\n"
"mejor! Con el paso de los años, ha amasado una buena colección, incluyendo\n"
"algunas muy raras y encantadas.\n"

#. key: crazy yiuf
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:crazy yiuf"
msgid ""
"A withered old gnoll with a long silver beard, wielding a quarterstaff and\n"
"wearing a cloak. He looks like a figure from mythology! Wait, is his beard held\n"
"on to his ears with hooks?\n"
msgstr ""
"Un viejo y raquítico gnoll con una larga barba plateada, que empuña un bastón\n"
"largo y lleva una capa. ¡Parece salido de la mitología! Espera, ¿lleva la barba\n"
"sujetada mediante ganchos sobre sus orejas?\n"

#. key: dispater
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:dispater"
msgid ""
"Greatest and most ruthless of the Lords of Hell, Dispater was born when first an\n"
"iron sword drank mortal blood. They despise mortal vanities, the pursuit of\n"
"‘reason’ and ‘beauty’ - the only art they enjoy is the art of war.\n"
msgstr ""
"El señor de la Ciudad de Hierro de Dis.\n"

#. key: dissolution
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:dissolution"
msgid ""
"The Pits of Slime used to be a thriving civilisation, and Dissolution was the\n"
"prophet of their god. When the city was overtaken by its current residents,\n"
"only Dissolution survived, for they alone turned faithfully to the Slime God.\n"
"Dissolution became a tremendous mass of acidic ooze, yet retained their\n"
"intelligence. They are filled with hatred for anything that can hold a form.\n"
msgstr ""
"Los Fosos Cenagosos solían albergar una pujante civilización, y Disolución era\n"
"el profeta de su dios. Cuando la ciudad fue asaltada por su actuales moradores,\n"
"solo Disolución consiguió salvarse, ya que él fue el único que abrazó la fe del\n"
"Dios Mucilaginoso. Disolución se convirtió en una tremenda masa de efluvios\n"
"ácidos, pero conservó su inteligencia. Rebosa de odio hacia cualquier cosa que\n"
"tenga forma.\n"

#. key: donald
#. Preserve {{ lua }} delimiters exactly.
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:donald"
msgid ""
"{{\n"
"    local descript = \"An adventurer just like you, trying to find the Orb.\"\n"
"\n"
"    if you.race() ~= \"Merfolk\" and you.race() ~= \"Octopode\" then\n"
"        descript = descript .. \" Unlike you, and d\"\n"
"    else\n"
"        descript = descript .. \" D\"\n"
"    end\n"
"\n"
"    descript = descript .. \"espite his hatred of it, he takes to water \" ..\n"
"                           \"like a fowl.\"\n"
"\n"
"    return descript\n"
"}}\n"
msgstr ""
"{{\n"
"    local descript = \"Un aventurero al igual que tú, que intenta encontrar el\n"
"Orbe.\"\n"
"\n"
"    if you.race() ~= \"Merfolk\" and you.race() ~= \"Octopode\" then\n"
"        descript = descript .. \" A diferencia de ti, y a\"\n"
"    else\n"
"        descript = descript .. \" A\"\n"
"    end\n"
"\n"
"    descript = descript .. \" pesar de odiarla, se zambulle en el agua \" ..\n"
"                           \"como una gallina.\"\n"
"\n"
"    return descript\n"
"}}\n"

#. key: dowan
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:dowan"
msgid ""
"A beautiful but vain deep elf with an aptitude for magic and little else. His\n"
"skills are the perfect complement of his twin sister Duvessa's fighting prowess.\n"
"In search of more powerful spells, he journeys to the surface with his sister.\n"
msgstr ""
"Un apuesto pero vanidoso elfo con talento para la magia y poco más. Sus\n"
"habilidades son el perfecto complemento para la destreza en el combate de su\n"
"hermana gemela Duvessa.\n"

#. key: duvessa
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:duvessa"
msgid ""
"A plain-looking deep elven fighter who is technically brilliant in many forms of\n"
"combat, but over-confident because of it. She is complemented by the magical\n"
"skills of her twin brother, Dowan. She journeys to the surface to challenge\n"
"its greatest champions.\n"
msgstr ""
"Una luchadora élfica aparentemente corriente, que es un genio en muchas formas\n"
"de combate, aunque también demasiado confiada, por esta misma razón. Dowan, su\n"
"hermano gemelo, le complementa con sus habilidades mágicas.\n"

#. key: edmund
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:edmund"
msgid ""
"A jealous sibling of Sigmund (indeed, the youngest of nine brothers). He has\n"
"none of Sigmund's skills in magic, but makes up for it with his skills in\n"
"fighting and a canny head for money. He is eager to prove his superiority by\n"
"killing hapless adventurers with his expensive flail and quick wit.\n"
msgstr ""
"Un celoso hermano menor de Sigmund (de hecho, el menor de nueve hermanos). No\n"
"tiene ninguno de los talentos de Sigmund para la magia, pero lo compensa con su\n"
"destreza para la lucha y una astuta mente para el dinero. Está más que\n"
"dispuesto a probar su superioridad matando a desventurados aventureros con su\n"
"caro mayal y su mente despierta.\n"

#. key: ereshkigal
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:ereshkigal"
msgid ""
"Greatest and most inexorable of the Lords of Hell, Ereshkigal was born when\n"
"first a mortal breathed her last. Noiselessly she laughs at lives cut short and\n"
"loved ones separated by untimely death, enwreathed in the silence of the grave.\n"
msgstr ""
"Un terrible archi-demonio que domina el mortal inframundo del Tártaro.\n"

#. key: erolcha
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:erolcha"
msgid ""
"An especially cunning ogre-mage.\n"
msgstr ""
"Una maga ogresa especialmente astuta.\n"

#. key: eustachio
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:eustachio"
msgid ""
"An apprentice summoner with a flowing moustache. He has funny ideas about\n"
"honour.\n"
msgstr ""
"Un aprendiz de convocador con un bigote ondeante. Tiene ideas divertidas acerca\n"
"del honor.\n"

#. key: frances
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:frances"
msgid ""
"A stout warrior who once bested a powerful lord of Pandemonium in combat,\n"
"gaining control over the demon's realm and thanes. The battle left her with a\n"
"deep facial scar, one that she carries as a badge of honour rather than a\n"
"symbol of shame.\n"
msgstr ""
"Una fuerte guerrera que una vez derrotó a un poderoso señor del Pandemonio en\n"
"combate, pasando a tener control de su reino y vasallos. La batalla le dejó una\n"
"cicatriz profunda en su rostro, que exhibe como una medalla al valor más que\n"
"como un motivo de vergüenza.\n"

#. key: frederick
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:frederick"
msgid ""
"A svelte fighter-mage with a gold-rimmed monocle, a keen sense of tradition,\n"
"and the blood of the gods running through his veins. He's here looking for a\n"
"worthy opponent, but he's yet to find one.\n"
msgstr ""
"Un esbelto mago-guerrero que lleva un monóculo dorado y busca un oponente digno\n"
"de él. Probablemente no cumples los requisitos.\n"

#. key: gastronok
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:gastronok"
msgid ""
"A voracious and surprisingly intelligent slug, devoted to eating everything and\n"
"everyone he comes across, with a pointed hat perched rakishly atop his head. He\n"
"acquired the hat the same way he acquired his intelligence and his knowledge of\n"
"spells: by consuming their former owner, a powerful wizard.\n"
msgstr ""
"Una voraz babosa sorprendentemente inteligente, dedicada a devorar todo y a\n"
"todo aquél que se encuentre a su paso, con un sombrero puntiagudo que lleva\n"
"desenfadadamente encima de su cabeza. Consiguió el sombrero de la misma forma\n"
"que consiguió su inteligencia y su conocimiento de la magia: consumiendo a su\n"
"antiguo propietario, un poderoso mago.\n"

#. key: gloorx vloq
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:gloorx vloq"
msgid ""
"A shadowy figure clothed in profound darkness.\n"
msgstr ""
"Una sombría figura inmersa en profundas tinieblas.\n"

#. key: grinder
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:grinder"
msgid ""
"An inefficient shadow imp previously employed as a torturer in one of the lower\n"
"circles of Hell. She has a tendency to complain and make inane statements.\n"
msgstr ""
"Un ineficiente diablillo de las sombras que previamente trabajaba como\n"
"torturador en uno de los círculos menores del Infierno. Tiene tendencia a\n"
"quejarse y a decir comentarios inanes.\n"

#. key: grum
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:grum"
msgid ""
"A tough-looking gnoll, wearing the pelt of one of his former war dogs.\n"
msgstr ""
"Un gnoll de aspecto duro, que viste la piel de uno de sus antiguos perros de\n"
"guerra.\n"

#. key: harold
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:harold"
msgid ""
"A middle-aged bounty hunter, anxious to retire after one final job. He hopes to\n"
"settle down somewhere and live a quiet life with his family, using the money\n"
"from his final bounty: you.\n"
msgstr ""
"Un cazador de recompensas de mediana edad, contratado para asesinarte. Tiene\n"
"prisa.\n"

#. key: ignacio
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:ignacio"
msgid ""
"While a mortal cannot turn into a demon aside from divine intervention, this is\n"
"what happened to Ignacio after Makhleb saw his love for his job and smiled upon\n"
"him. He is now slated to continue the joy of his life for all eternity.\n"
"\n"
"Although his new form includes a number of large razor-sharp blades growing\n"
"from his demonic appendages, he kept his favourite axe and is eager to let you\n"
"test its edge.\n"
msgstr ""
"Un mortal no puede convertirse en demonio mientras que los dioses no\n"
"intervengan, y esto fue lo que le sucedió a Ignacio cuando Makhleb vio su amor\n"
"a su trabajo y le sonrió. Ahora está destinado a seguir con lo que le divertía\n"
"por toda la eternidad.\n"
"\n"
"Aunque su nueva forma tiene varias cuchillas enormes saliendo de sus apéndices\n"
"de demonio, todavía conserva su hacha favorita y está dispuesto a hacerte\n"
"probar su filo.\n"

#. key: ijyb
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:ijyb"
msgid ""
"A small and shrewd goblin inventor, wearing blue rags coated in soot.\n"
"She claims dominion over this level of the dungeon; trespassers will find\n"
"themselves on the business end of a homemade wand.\n"
msgstr ""
"Un pequeño y retorcido goblin que viste harapos azules.\n"

#. key: jessica
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:jessica"
msgid ""
"An evil apprentice sorceress. She entered the dungeon hoping to find a quiet,\n"
"secluded place where she could study the darker arts without being disturbed.\n"
msgstr ""
"Una malvada aprendiz de hechicera. Entró en el calabozo esperando encontrar un\n"
"lugar tranquilo y apartado donde pudiera estudiar las artes oscuras sin ser\n"
"molestada.\n"

#. key: jory
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:jory"
msgid ""
"Once a simple village peasant, Jory found himself transformed in undeath into a\n"
"powerful creature. Through the countless centuries unlived since then, he has\n"
"honed his skills in combat and magic, and amassed great wealth and many\n"
"possessions.\n"
msgstr ""
"El que fuera una vez un simple granjero, Jory se vio transformado en un\n"
"poderoso no-muerto. A través de los incontables siglos desprovisto de vida ha\n"
"entrenado sus habilidades en combate y en magia, amasado grandes riquezas y\n"
"muchas posesiones.\n"

#. key: joseph
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:joseph"
msgid ""
"Looks like a mercenary in a stupid-looking hat.\n"
msgstr ""
"Parece un mercenario.\n"

#. key: lom lobon
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:lom lobon"
msgid ""
"Stoic and inscrutable, Lom Lobon is an ancient demon infamous for their mastery\n"
"of magic. Rumoured to be the most learned being in the halls of Pandemonium,\n"
"they are at times sought out by mortal wizards who offer their souls in\n"
"exchange for the secrets of the arcane. Lacking the terrible wrath present in\n"
"most demons, Lom Lobon's single eye instead hides a cold, impartial cruelty.\n"
msgstr ""
"Un antiguo y extrañamente sereno demonio. Te mira fríamente con el enorme y\n"
"luminoso ojo que tiene en el centro de su frente.\n"

#. key: louise
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:louise"
msgid ""
"A mighty sorceress, clad from head to toe in heavy armour. Once an adventurer\n"
"looking for the fabled Orb of Zot, she was cast into the Abyss and got\n"
"hopelessly lost there. Toyed with by some greater power, she was stuck on the\n"
"hostile plane for nearly a decade. When she finally emerged from the Abyss,\n"
"Louise had become powerful indeed, but had also gone fully insane. She now\n"
"wanders the halls of the dungeon, seeking other adventurers to share her fate.\n"
msgstr ""
"Un hechicero inusualmente acorazado.\n"

#. key: margery
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:margery"
msgid ""
"A lithe spellcaster in service to the powers of Hell; it is her duty to ensure\n"
"that the inhabitants of the Dungeon never forget their place. She personally\n"
"slew the ancient dragon from whose hide her strange armour is crafted.\n"
msgstr ""
"Una grácil y flexible hechicera. Apenas está vestida, aunque lo poco que lleva\n"
"parece armadura de dragón de la más alta calidad, garantizando alta protección.\n"
"Y distraer a humanoides masculinos también tiene su valor en combate, además.\n"

#. key: maurice
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:maurice"
msgid ""
"A sly, conniving thief. A self-proclaimed legend, he was one of the most skilled\n"
"and crafty of the thieves and rogues lured by the Orb. The magical parasitic\n"
"vines that have claimed his body still wish to continue his life's work, with a\n"
"back-up plan of both a vicious magic-drinking maw and potent wands.\n"
msgstr ""
"Un astuto y conspirador ladrón.\n"

#. key: menkaure
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:menkaure"
msgid ""
"A fair and noble ruler of an ancient and mighty kingdom, mummified after an\n"
"early death. His faithful priests subsequently infused him with great and\n"
"powerful magic, seeking to grant him eternal life. Now he is forgotten and\n"
"reduced to mouldering bandages and dry, brittle bones.\n"
msgstr ""
"Un justo y noble soberano de un antiguo y poderoso reino, momificado tras su\n"
"temprana muerte. Sus fieles sacerdotes le infundieron gran y poderosa magia,\n"
"pretendiendo concederle la vida eterna. Ahora ha quedado olvidado y reducido a\n"
"vendajes enmohecidos y huesos secos y quebradizos.\n"

#. key: mennas
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:mennas"
msgid ""
"There was once a human priest named Mennas. He travelled far and wide as a\n"
"missionary of Zin, often venturing even into Orcish lands. He beseeched the orcs\n"
"to abandon their false tribes and return to the peoples of their birth; only\n"
"Zin's light could truly cleanse the weight of sin that had twisted their bodies.\n"
"\n"
"By all accounts the orcs were not happy with Mennas. Eventually, a group of them\n"
"demanded he recant his words and when Mennas remained silent, they cut out his\n"
"tongue.\n"
"\n"
"Whether or not this angel is that same Mennas is something of a mystery, as he\n"
"seems to have difficulty speaking.\n"
msgstr ""
"Hubo una vez un sacerdote humano llamado Mennas. Viajó a lo largo y a lo ancho\n"
"predicando la palabra de Zin a cualquiera que quisiera escuchar, yendo incluso\n"
"tan lejos como para adentrarse en tierras orcas, predicando a los orcos sobre\n"
"leyes y misericordia. A los orcos no les hizo gracia alguna. Le pidieron que\n"
"jurara que Beogh era el único dios verdadero y cuando Mennas permaneció callado\n"
"le cortaron la lengua.\n"
"\n"
"Tanto si este ángel es o no el mismo Mennas es un misterio, pero parece que le\n"
"cueste hablar.\n"

#. key: mnoleg
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:mnoleg"
msgid ""
"A weirdly glowing figure, dancing through the twisted air of Pandemonium.\n"
msgstr ""
"Una figura extrañamente luminosa, danzando en los remolinos de aire del\n"
"Pandemonio.\n"

#. key: nellie
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:nellie"
msgid ""
"A highly intelligent elephant who travelled as part of a circus. One dark\n"
"night, she slipped out of her chain and disappeared into Pandemonium, never to\n"
"be seen again.\n"
msgstr ""
"Una elefante muy inteligente que viajaba formando parte de un circo. Una noche\n"
"oscura se escapó de su cadena y desapareció en el Pandemonio, para no ser vista\n"
"nunca más.\n"

#. key: nikola
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:nikola"
msgid ""
"A brilliant scientist obsessed with electricity. In his attempts to perfect his\n"
"electric golem, he was involved in a terrible accident, and now phases in and\n"
"out of reality.\n"
msgstr ""
"Un científico brillante obsesionado con la electricidad. En su tentativa de\n"
"perfeccionar su golem eléctrico, se vio envuelto en un terrible accidente, y\n"
"ahora fluctúa en diferentes fases de la realidad.\n"

#. key: pargi
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:pargi"
msgid ""
"An unusually weak troll.\n"
msgstr ""
"Un troll inusualmente delgado.\n"
"\n"
"Sientes algo en la boca de tu estómago.\n"

#. key: polyphemus
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:polyphemus"
msgid ""
"A cyclops shepherd, he is very protective of his charges, whom he watches with\n"
"an undying fervor through his single massive eye. Nevertheless, he won't\n"
"hesitate to use them as projectiles in a pinch; after all, the best defence is\n"
"a good offence.\n"
msgstr ""
"Un pastor cíclope, celoso guardián de su rebaño al que vigila con incansable\n"
"fervor mediante su único ojo masivo.\n"

#. key: rupert
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:rupert"
msgid ""
"Rippling muscles, glistening pecs, incredible glutes - Rupert is the peak of\n"
"physical perfection. Even so, his roars seem louder than even his fantastic form\n"
"can explain. Perhaps he holds some talisman that lends supernatural force to his\n"
"bellows?\n"
msgstr ""
"Un tipo con muy malos modos cuyos rugidos causan la envidia incluso de los\n"
"ogros.\n"

#. key: saint roka
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:saint roka"
msgid ""
"A mighty warlord. Some orcs even say they are the Chosen One of Beogh.\n"
msgstr ""
"Un poderoso señor de la guerra. Algunos orcos llegan incluso a decir que él es\n"
"El Elegido de Beogh.\n"

#. key: sigmund
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:sigmund"
msgid ""
"The elder of a pair of brothers who came for the Orb. No one knows what Sigmund\n"
"saw in the dungeon to drive him mad, but his shrewd magical tactics and wicked\n"
"scythe now leave little time for his victims to wonder. Despite his reputation\n"
"as a vicious murderer, his grandiose and dramatic ways have earned him the\n"
"admiration of many denizens of the dungeon.\n"
msgstr ""
"La pesadilla de todos los aventureros jóvenes, Sigmund combina ilusiones de\n"
"grandeza con sucias tácticas.\n"

#. key: snorg
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:snorg"
msgid ""
"A particularly corpulent troll with a short temper and a sizable gut.\n"
"Uninterested in the Orb, Snorg delights in the endless parade of adventurers –\n"
"that is, easy meals — it attracts.\n"
msgstr ""
"Un troll particularmente corpulento con poco temperamento y una importante\n"
"tripa. Sin ningún interés en el Orbe, Snorg se deleita con el sin fin de\n"
"aventureros — esto es, platos fáciles — a los que atrae.\n"

#. key: sonja
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:sonja"
msgid ""
"A graceful kobold assassin. Admire her graceful pirouettes, thrill at her\n"
"daring leaps! But watch out for her knives!\n"
msgstr ""
"Una grácil asesina kobold. ¡Admira sus airosas piruetas, emocionate con sus\n"
"atrevidos saltos! El espacio alrededor del filo de su arma parece fluctuar\n"
"ligeramente por un momento... o, ¿es que realmente fluctua?\n"
"\n"
"Su sombrío cuerpo de can, ocultado amablemente por el holgado atuendo de color\n"
"verde, contrasta con sus decididos ojos, que otean las inmediaciones desde la\n"
"sombra creada por el borde superior de su capa del color del berilo. Las fosas\n"
"nasales que se asoman en la punta de su hocico palpitan de entusiasmo.\n"

#. key: terence
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:terence"
msgid ""
"A veteran of a war against the armataurs' elephant-riders. He has recently\n"
"retired to make a new home in the dungeon.\n"
msgstr ""
"Un violento asesino que mata tanto por placer como por interés, Terence se vio\n"
"obligado a esconderse después de que uno de sus trabajos le saliera torcido, y\n"
"no puede permitir que alguien que le haya visto salga vivo del calabazo — hay\n"
"una recompensa por su cabeza, después de todo.\n"

#. key: urug
#. Preserve {{ lua }} delimiters exactly.
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:urug"
msgid ""
"A coarse and lanky orc. Urug lost her eye in a fight with a harpy, and has\n"
"sworn to slay every last one of them. Unfortunately, the vision in her\n"
"remaining eye is not very good, and she has mistaken you for one.\n"
"{{\n"
"    if you.can_smell() then\n"
"        return \"She smells terrible.\"\n"
"    end\n"
"}}\n"
msgstr ""
"Un tosco y larguirucho orco. Urug perdió un ojo en un combate contra una\n"
"harpía, y juró exterminarlas a todas. Desgraciadamente, la visión con el ojo\n"
"que le queda no es muy buena y te ha confundido con una de ellas.\n"
"{{\n"
"    if you.can_smell() then\n"
"        return \"Huele fatal.\"\n"
"    else\n"
"        return \"\"\n"
"    end\n"
"}}\n"

#. key: xtahua
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:xtahua"
msgid ""
"An ancient and mighty dragon.\n"
msgstr ""
"Un antiguo y poderoso dragón. Su abrasado cuerpo cubierto con peñascos de lava\n"
"endurecida se eleva sobre el suelo del calabozo, dejando tras de sí una estela\n"
"con un penetrante olor a azufre. Un conjunto de enormes garras resaltan en las\n"
"terminaciones de sus extremidades, y sus filos, aunque algo mellados después\n"
"haber sido usados por tanto tiempo, parecen capaces de despedazar a un hombre\n"
"en un simple instante. La calidez que emana de su sola presencia calienta el\n"
"aire hasta hacerlo insoportable, y hace que las estructuras visibles en el\n"
"calabozo se arqueen ligeramente, como si del mismísimo sol del verano se\n"
"tratara.\n"
"\n"
"Xtahua se fue volviendo cada vez más resentido, al verse atrapado en el\n"
"calabozo después de una agotadora batalla con un aventurero hace siglos. La\n"
"mayoría de su razones para seguir viviendo se han reducido simplemente a la de\n"
"hacer arder cualquier cosa que merodee por estas salas con una pasión\n"
"incombustible.\n"

#. key: acid blob
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:acid blob"
msgid ""
"A lump of sickly pustulent flesh, dripping with lethal acid.\n"
msgstr ""
"Un amasijo de carne infecta y con pústulas que gotea ácido.\n"

#. key: adder
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:adder"
msgid ""
"A common dungeon snake, a species of troglodytic reptile commonly found in\n"
"subterranean spaces.\n"
msgstr ""
"La serpiente más común del calabozo. Una especie de vetusto reptil que\n"
"habitualmente se halla en lugares subterráneos.\n"

#. key: air elemental
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:air elemental"
msgid ""
"A spirit drawn from the elemental plane of air. It exists in this world as a\n"
"lightning-spitting spirit, stunning foes with its crackling bursts.\n"
msgstr ""
"Un espíritu proveniente del plano elemental del aire. Se materializa en este\n"
"plano como un remolino que a menudo se disipa  y se vuelve a formar poco\n"
"después.\n"

#. key: alligator
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:alligator"
msgid ""
"An aggressive crocodilian with great crunching jaws full of sharp teeth.\n"
msgstr ""
"Un escurridizo cocodriliano que se oculta en el agua y espera pacientemente a\n"
"que su victima se acerque, para abalanzarse sobre ella con gran velocidad y\n"
"aplastarla con sus enormes fauces.\n"

#. key: alligator snapping turtle
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:alligator snapping turtle"
msgid ""
"A particularly large and nasty snapping turtle. Like its smaller relative, it\n"
"can reach out and bite from afar.\n"
msgstr ""
"Una tortuga mordedora particularmente grande y desagradable. Al igual que su\n"
"parentela de menor tamaño, es capaz de alcanzarte y morderte desde cierta\n"
"distancia, y se esconderá en su caparazón cuando se vea amenazada.\n"

#. key: anaconda
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:anaconda"
msgid ""
"A very large snake that moves with startling swiftness. It kills not by poison\n"
"but by constricting its prey.\n"
msgstr ""
"Una enorme serpiente que se desplaza con una velocidad asombrosa tanto por\n"
"tierra como por agua. No mata a sus victimas mediante venenos sino que las\n"
"asfixia.\n"

#. key: ancient champion
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:ancient champion"
msgid ""
"An unfathomably ancient skeleton. It has hundreds of golden sigils etched onto\n"
"its bones, and pulses with terrible, unholy power.\n"
msgstr ""
"Un antiguo e insondable esqueleto. Tiene cientos de sellos dorados grabados en\n"
"sus huesos y palpita con una terrible energía impía.\n"

#. key: ancient lich
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:ancient lich"
msgid ""
"A lich who, having existed for countless centuries, has grown almost\n"
"unimaginably powerful through the study of dark magic.\n"
msgstr ""
"Un liche el cual, habiendo existido por incontables siglos, ha alcanzado un\n"
"nivel casi inimaginable en el estudio de la magia negra\n"

#. key: angel
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:angel"
msgid ""
"A divine warrior of the Shining One. It is a towering winged figure of\n"
"unnatural beauty surrounded by an aura of brilliant white light.\n"
msgstr ""
"Un guerrero divino de El Resplandeciente. Su imponente figura alada, de una\n"
"belleza propia de otro mundo, está bañada por una aura de brillante luz blanca.\n"
"Al volar, da la sensación de ser muy ligero y bastante ágil, a pesar de la\n"
"pesada armadura que lleva.\n"

#. key: apis
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:apis"
msgid ""
"A placid, sacred bull of Elyvilon. Its status as an exalted envoy of the Healer\n"
"lets its very presence double the health of its allies.\n"
msgstr ""
"Un plácido toro sagrado de Elyvilon. ¡Cuidado, servidores del mal, ya que con\n"
"certeza se volverá contra vosotros!\n"

#. key: azure jelly
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:azure jelly"
msgid ""
"An extremely cold blob of bright blue cytoplasm, forming bits of frost in the\n"
"air around it.\n"
msgstr ""
"Una masa de citoplasma azulado y extremadamente frío, envuelta en escarcha.\n"

#. key: ball lightning
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:ball lightning"
msgid ""
"A swift sphere of coruscating electrical energy. It will explode at the\n"
"slightest disturbance.\n"
msgstr ""
"Una enorme y veloz esfera resplandeciente de energía eléctrica. Explotará en\n"
"cuanto sea provocada.\n"

#. key: balrug
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:balrug"
msgid ""
"A huge and very powerful demon, wreathed in fire and shadows.\n"
msgstr ""
"Un demonio enorme y muy poderoso, envuelto en llamas y sombras.\n"

#. key: brimstone fiend
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:brimstone fiend"
msgid ""
"A huge and powerful demon wreathed in damnation, with great scaly wings. It is\n"
"one of the most fearsome denizens of any of the Hells.\n"
msgstr ""
"Un enorme y poderoso demonio bañado en fuego infernal, con amplias alas\n"
"escamosas. Uno de los más temibles habitantes de cualquiera de los Infiernos.\n"

#. key: centaur
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:centaur"
msgid ""
"A hybrid with the torso of a human atop the body of a horse. It is highly\n"
"skilled in archery.\n"
msgstr ""
"Un híbrido con el torso de un humano en lo alto del cuerpo de un gran caballo.\n"
"Los centauros son famosos por ser hábiles arqueros.\n"

#. key: centaur warrior
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:centaur warrior"
msgid ""
"A muscular centaur, veteran of numerous battles, armed with well-made weapons\n"
"and able to use them skilfully.\n"
msgstr ""
"Un centauro musculoso y curtido en numerosas batallas, equipado con buenas\n"
"armas y capaz de usarlas hábilmente.\n"

#. key: executioner
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:executioner"
msgid ""
"A horribly powerful and swift demon, its shape obscured by a cloud of swirling\n"
"scythe-like blades.\n"
msgstr ""
"Un horrible, poderoso y ágil demonio cuya forma está oculta en un remolino de\n"
"hojas de guadaña\n"

#. key: gnoll
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:gnoll"
msgid ""
"A taller and better-equipped relative of goblins, and ally of orcs. It is\n"
"somewhat doglike in appearance.\n"
msgstr ""
"Un pariente a los duendes y aliado a los orcos. Está más alto y de alguna\n"
"manera mejor equipado que los duendes y ve un poco como un perro.\n"

#. key: hell sentinel
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:hell sentinel"
msgid ""
"A towering monolith constructed and possessed by demonic forces. A thousand\n"
"eyes leer through slits in its jagged, spiked armour.\n"
msgstr ""
"Un imponente monolito construido y poseído por fuerzas demoníacas. Unos mil\n"
"ojos miran lascivamente por las rendijas de su armadura dentada y espinosa.\n"

#. key: hellion
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:hellion"
msgid ""
"A hateful demon, desirous to see all life destroyed by its damnation.\n"
msgstr ""
"Un demonio malévolo que quiere ver toda vida destruido por su fuego.\n"

#. key: ice devil
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:ice devil"
msgid ""
"A man-sized demon covered in glittering ice.\n"
msgstr ""
"Un demonio tan grande como una humana. Es cubierto en hielo.\n"

#. key: ice fiend
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:ice fiend"
msgid ""
"A huge frigid demon covered in frost and wreathed in freezing air. It is one of\n"
"the most terrible denizens of the many Hells.\n"
msgstr ""
"Un enorme y frío demonio cubierto en escarcha y revestido en aire helado. Es\n"
"uno de los habitantes más terribles de los muchos y variados Infiernos.\n"

#. key: iron golem
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:iron golem"
msgid ""
"A large, ponderous and very solid statue of metal, given the power of\n"
"locomotion through some esoteric means.\n"
msgstr ""
"Una estatua grande, pesada y muy robusta, dada el poder de movimiento por\n"
"esotéricos (y posiblemente a base de calabaza) medios.\n"

#. key: iron imp
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:iron imp"
msgid ""
"An ugly, twisted little minor demon with metal skin.\n"
msgstr ""
"Un demonio feo y pequeño con piel metálica.\n"

#. key: killer klown
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:killer klown"
msgid ""
"A comical figure full of life and laughter. It looks very happy to see you...\n"
"but is there a slightly malicious cast to its features? Is that red face paint\n"
"or something altogether less pleasant?\n"
msgstr ""
"Una figura cómica llena de vida y de risas. Parece muy contento de verte...\n"
"¿pero acaso hay algo levemente malicioso en su proceder? ¿Su cara tiene pintura\n"
"roja o es algo menos agradable?\n"

#. key: orb guardian
#: dat/descript/monsters.txt
msgctxt ""
"textdb:descriptions:orb guardian"
msgid ""
"A huge, glowing, four-limbed purple creature with heightened senses, created by\n"
"the Orb itself. It guards the Orb with enormous punctiliousness and violence,\n"
"and its death will alert any Boundless Tesseracts on the level to begin creating\n"
"reinforcements.\n"
"\n"
"Unless the Orb has already been disturbed, it will refuse to abandon its duty\n"
"by leaving the floor.\n"
msgstr ""
"Una criatura de cuatro extremidades, púrpura, brillante y enorme, con sentidos\n"
"muy desarrollados, creada por el Orbe para custodiarse a sí mismo. Guarda el\n"
"Orbe con enorme dedicación y violencia.\n"

#. key: ashenzari
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:ashenzari"
msgid ""
"While it seems inconceivable that the divine could be shackled, Ashenzari is\n"
"just that: bound to the sky for eternity, the unbudging god is all-knowing,\n"
"all-seeing. Devoted worshippers are allowed to grasp shreds of this knowledge\n"
"and foresight, but be warned: to Ashenzari, power and blessing and curse are\n"
"all the same thing.\n"
msgstr ""
"Aunque pueda parecer inconcebible que algo divino pueda estar encadenado,\n"
"Ashenzari es eso: clavado adrede al cielo para la eternidad, el dios inamovible\n"
"es omnisciente. A sus devotos adoradores se les permite que conozcan retales de\n"
"su conocimiento y visión, pero alerta: para Ashenzari, el poder, las\n"
"bendiciones y las maldiciones son todo la misma cosa.\n"

#. key: beogh
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:beogh"
msgid ""
"A god of outcasts, pariahs, and the dispossessed, Beogh's altars are rarely\n"
"found among those of other faiths, but Beogh's missionaries may always be sought\n"
"by those looking for a place to belong. Worshippers will find many friends\n"
"within the dungeon, and those who prove their strength to Beogh may gain\n"
"lifelong companions the equal of any adventurer. To worship Beogh is to believe\n"
"there is strength that transcends species and bloodline. To worship Beogh is to\n"
"be an orc.\n"
msgstr ""
"Beogh es una deidad malvada, adorado por los orcos de cuevas nativos del\n"
"calabozo. Sólo los orcos se pueden dedicar al servicio de Beogh, y ellos deben\n"
"probar su devoción a través de la matanza. Los devotos de Beogh especialmente\n"
"fervientes encontrarán a otros seguidores orcos acudiendo a su bandera: ésta es\n"
"una época de señales y augurios, y los orcos están cada vez más seguros de que\n"
"la llegada de su Mesías se acerca.\n"

#. key: cheibriados
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:cheibriados"
msgid ""
"Cheibriados is a god of deliberation. Those following Cheibriados travel more\n"
"slowly the further they progress in their faith, and are forbidden from using\n"
"any means to hasten themselves. In the process of so imitating their god, they\n"
"attain perfection of mind and body, and the mysteries of time unfold before\n"
"them. Especially devout followers may even momentarily abandon the flow of\n"
"time and its needless disturbances.\n"
msgstr ""
"Cheibriados es un dios que medita en el misterio del tiempo. Aquellos que\n"
"elijan seguir su camino aprenderán a desprenderse de las prisas innecesarias,\n"
"enlentecerse y volver lentos a los demás, y a dañar a aquellos que rechacen tal\n"
"situación. Seguidores especialmente devotos pueden incluso abandonar\n"
"temporalmente el flujo del tiempo y sus innecesarias molestias.\n"

#. key: dithmenos
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:dithmenos"
msgid ""
"Dithmenos is the god of night and of things half-seen in flickering torchlight.\n"
"Worshipped by actors as often as thieves, followers of Dithmenos can learn to\n"
"control their own shadow as if it were an extension of their body - misdirecting\n"
"onlookers and acting upon the world with force as tangible as anything that has\n"
"ever been imagined lurking in the dark.\n"
msgstr ""
"Dithmenos el sombrío desea que todo sea oscuridad. Sus seguidores ganan una\n"
"afinidad extraña y sobrenatural sobre las sombras en su entorno. Este dios odia\n"
"el fuego, el cual liberó hace tiempo a los mortales de la tiranía de las\n"
"sombras; su uso está prohibido por sus seguidores. Dithmenos favorece a quienes\n"
"destruyan cualquier fuente de fuego.\n"

#. key: elyvilon
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:elyvilon"
msgid ""
"Elyvilon the Healer welcomes all kind souls prepared to help others. Those\n"
"individuals can expect to gain powerful healing abilities, by which they can\n"
"avoid bloodshed. Elyvilon appreciates exploration of the dungeon. Elyvilon's\n"
"followers can convert to the Shining One or Zin while keeping some piety.\n"
msgstr ""
"Elyvilon, «quien sana», acoge a todas las buenas almas que estén preparadas\n"
"para ayudar a los demás. Tales individuos pueden esperar ganar poderosas\n"
"habilidades de sanación. Elyvilon prefiere un credo de pacifismo y ayuda a sus\n"
"seguidores a evitar baños de sangre. Elyvilon aprecia la destrucción de armas,\n"
"aunque los seguidores más piadosos deben encontrar y destruir armas impías o\n"
"malignas para ganar piedad de esta forma. Los seguidores de Elyvilon pueden\n"
"convertirse en seguidores de El Resplandeciente o de Zin conservando algo de\n"
"piedad.\n"

#. key: fedhas
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:fedhas"
msgid ""
"Fedhas is the god of plant and fungal life. Followers are prevented from\n"
"harming any species under Fedhas' protection. In return, Fedhas grants a number\n"
"of abilities that promote the growth of plants and fungi. These abilities may\n"
"incidentally prove useful to adventurers.\n"
msgstr ""
"Fedhas Madash es un dios de las plantas y hongos. Fedhas demanda que sus\n"
"seguidores auspicien la descomposición de cadáveres. Fedhas prohíbe dañar a\n"
"ninguna especie bajo su protección y usar efectos de necromancia que\n"
"interfieran con los cadáveres. En compensación Fedhas da varias habilidades que\n"
"promueven el crecimiento de plantas y hongos. Tales habilidades pueden ser\n"
"útiles para los aventureros.\n"

#. key: gozag
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:gozag"
msgid ""
"Gozag Ym Sagoz the Greedy teaches that the world belongs to the rich. Those\n"
"accepting this principle may exchange their gold for divine assistance.\n"
"Followers of Gozag do not earn piety; the only way to impress this god is by\n"
"amassing a fortune, and worshippers may request as much assistance as they can\n"
"afford. Fortunately, Gozag's worshippers are said to have the touch of gold.\n"
msgstr ""
"Gozag Ym Sagoz, el avaro, enseña que el mundo pertenece a los ricos. Quienes\n"
"acepten este principio pueden comprar su asistencia divina con oro. Los\n"
"seguidores de Gozag no ganan piedad; sólo se puede impresionar a Gozag con\n"
"oro y fortuna. Así sus seguidores pueden pedir tantos favores como puedan\n"
"costear. Afortunadamente, se dice que los seguidores de Gozag tienen el toque\n"
"del oro.\n"

#. key: jiyva
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:jiyva"
msgid ""
"Jiyva is the ancient deity of the slimes. Followers are expected to\n"
"support the spread and satiation of their fellow slimes by allowing them to\n"
"consume items, and are prevented from harming any slimes. Especially favoured\n"
"followers will become as shapeless as their god, mutating wildly.\n"
msgstr ""
"Jiyva es la antigua y caótica deidad de los limos. Sus seguidores deben\n"
"apoyar la diseminación y alimentación de sus camaradas permitiéndoles consumir\n"
"objetos, y tienen prohibido dañar a cualquier limo. Jiyva ocasionalmente\n"
"incluso consumirá objetos dejados en alguna parte del calabozo. Seguidores\n"
"especialmente favorecidos se volverán tan carentes de forma como su dios a\n"
"medida que sus atributos y mutaciones van cambiando bajo la influencia de\n"
"Jiyva.\n"

#. key: kikubaaqudgha
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:kikubaaqudgha"
msgid ""
"Kikubaaqudgha is a terrible Demon-God, served by those who wish to indulge in\n"
"the powers of death. An evil god, Kikubaaqudgha requires worshippers to cause\n"
"the death and destruction of as many creatures as possible. In exchange,\n"
"Kikubaaqudgha offers great assistance to the aspiring necromancer: a supply of\n"
"useful bodies, knowledge of dark magic, and protection against necromantic\n"
"backlash.\n"
msgstr ""
"Kikubaaqudgha es un terrible dios demonio, al que sirven aquellos que quieren\n"
"manipular los poderes de la muerte. Kikubaaqudgha es una deidad maligna y\n"
"demanda muertes de criaturas vivas y de demonios tan a menudo como sea posible.\n"
"A cambio, Kikubaaqudgha ofrece gran asistencia a quien aspire ser un\n"
"nigromante: libros de hechizos repletos de magia negra, protección y una vasta\n"
"fuente de cadáveres directamente del mausoleo de Kikubaaqudgha.\n"

#. key: lugonu
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:lugonu"
msgid ""
"Banished to the chaotic realm of the Abyss, Lugonu the Unformed seeks followers\n"
"to spread bloodshed and corruption in the overworld. Those who gain Lugonu's\n"
"favour will be granted some of the power of the Abyss itself, allowing them to\n"
"call forth eldritch horrors, and even to travel between the overworld and the\n"
"Abyss at will.\n"
msgstr ""
"Lugonu, «informe», se revela en el caos del Abismo. Sus seguidores son enviados\n"
"para causar masacres y corromper al mundo superior, y deben hacerlo sin\n"
"descanso para ganar el favor de Lugonu. Quienes ganen el favor de Lugonu\n"
"heredan algo de su poder sobre el Abismo, permitiéndoles invocar horres\n"
"macabros, incluso viajar entre el Abismo y el mundo superior a voluntad.\n"

#. key: makhleb
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:makhleb"
msgid ""
"Makhleb the Destroyer is a fearsome deity of bloodshed and mortification of the\n"
"flesh. Followers are expected to cleanse others by inflicting suffering and\n"
"death on them in Makhleb's name. Dedicated followers may also access the raw\n"
"energies and hell-spawned servants of chaos, so that they may better break the\n"
"impure world and its false laws for their evil god's glory.\n"
msgstr ""
"Makhleb, «quien destruye», es una terrible deidad de derramamientos de sangre y\n"
"mortificación de la carne. Sus seguidores purifican a los demás infligiéndoles\n"
"sufrimiento y muerte en nombre de Makhleb, y pueden ganar más favor destruyendo\n"
"a los cadáveres recientes. Los seguidores Dedicados pueden acceder a energías\n"
"caóticas puras y convocar sirvientes del caos de origen infernal, de modo\n"
"que puedan destruir este mundo impuro y sus leyes falsas para la gloria de este\n"
"malvado dios.\n"

#. key: nemelex xobeh
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:nemelex xobeh"
msgid ""
"Nemelex is a strange and unpredictable chaotic trickster god, whose powers are\n"
"invoked through magical packs of cards painted in the ichor of demons. Followers\n"
"will be granted decks of cards as they traverse the dungeon, and are encouraged\n"
"to trust in the cards to provide them with divine assistance. However, the\n"
"Trickster can also ensure that fortune favours the bold.\n"
msgstr ""
"Nemelex es un dios tramposo e impredecible, cuyos poderes pueden ser invocados\n"
"mediante paquetes de cartas mágicas pintadas con el icor de demonios. Sus\n"
"seguidores deben explorar el mundo, a cambio recibirán barajas de cartas.\n"
"Ellos deben confiar en las cartas y usarlas tanto como sea posible. Además,\n"
"Nemelex asegura que la fortuna favorece al más valiente.\n"

#. key: okawaru
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:okawaru"
msgid ""
"Okawaru is a dangerous and powerful god of battle. Followers are expected to\n"
"constantly prove themselves in combat, and may channel Okawaru's might to\n"
"enhance their prowess. Okawaru demands that followers prove themselves by their\n"
"own strength alone, and so worshippers are forbidden from gaining allies by any\n"
"means. Okawaru pays little heed to easy victories, but will reward worshippers\n"
"for heroic feats against mighty foes.\n"
msgstr ""
"Okawaru es un poderoso y peligroso dios de la guerra. Los seguidores pueden\n"
"ganar varios poderes útiles en combate además de ciertas recompensas, pero\n"
"deben constantemente probarse a sí mismos derrotando otras criaturas. Okawaru\n"
"prefiere gestos heroicos contra poderosos enemigos, y no presta mucha atención\n"
"a victorias fáciles. Okawaru menosprecia a quienes hieren a sus aliados.\n"

#. key: qazlal
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:qazlal"
msgid ""
"Qazlal Stormbringer is a violent god of tempests, who delights in unleashing\n"
"the forces of nature against the unsuspecting. Those who invite Qazlal's gaze\n"
"will find themselves the eye in a storm of elemental destruction, from which\n"
"only their God can protect them. Pious worshippers of Qazlal will gain the\n"
"ability to direct and control the destructive might of the storm.\n"
msgstr ""
"Qazlal «invocador de tormentas» es un dios violento de la tempestad, quien\n"
"disfruta desencadenando las fuerzas de la naturaleza contra el desprevenido.\n"
"Quienes inviten la mirada de Qazlal se encontrarán en el ojo de la tormenta\n"
"de destrucción elemental, del cuál sólo su dios puede protegerlos. Los\n"
"adoradores beatos de Qazlal ganarán la habilidad de dirigir y controlar el\n"
"poder destructivo de la tormenta.\n"

#. key: ru
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:ru"
msgid ""
"Of all the gods, only Ru opposed creation. Not as folly, but as distraction.\n"
"Initiates of Ru can open channels to the powers underlying the visible world by\n"
"renouncing the fetters that bind them here. These sacrifices are not made to\n"
"Ru, but rather given up freely and permanently. Having made such sacrifices,\n"
"initiates will become able to draw upon this immense power to aid themselves,\n"
"eventually gaining the ability to unleash its destructive might against their\n"
"foes.\n"
msgstr ""
"Entre todos los dioses, sólo Ru se opone a la creación. No como una locura,\n"
"sino como distracción. Los iniciados de Ru pueden abrir canales a los poderes\n"
"subyacentes al mundo visible al renunciar a las cadenas que los atan aquí.\n"
"Estos sacrificios no son para Ru, sino que se otorgan gratuita y\n"
"permanentemente. Sus seguidores pueden redirigir y contraatacar contra sus\n"
"enemigos, regenerar su salud y magia, realizar poderosos saltos, y liberar una\n"
"onda masiva de poder contra sus rivales.\n"

#. key: sif muna
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:sif muna"
msgid ""
"Sif Muna the Loreminder is a contemplative but powerful deity, served by those\n"
"who seek magical knowledge. Followers who triumph over their foes can call upon\n"
"the Loreminder for magical power and the ability to cast spells beyond their\n"
"magical training. The devout are rewarded with a supply of spellbooks taken\n"
"directly from Sif Muna's legendary library.\n"
msgstr ""
"Sif Muna, «quien posee el conocimiento» es una deidad contemplativa pero\n"
"poderosa, a quien sirven los que buscan conocimiento de la magia. Aprecia el\n"
"entrenamiento de las capacidades para hacer magia. Sif Muna recompensa a sus\n"
"seguidores más devotos con libros de hechizo exclusivos de su legendaria\n"
"biblioteca.\n"

#. key: the shining one
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:the shining one"
msgid ""
"Followers of the Shining One are bound to the code of the honourable warrior,\n"
"soldiers in their god's eternal crusade against evil. For forsaking dark magic\n"
"and underhanded tactics, the Shining One rewards them and their allies with the\n"
"power they need to slay demons and the undead. Especially devout warriors can\n"
"even call upon angels in times of need. The Shining One's followers can convert\n"
"to Elyvilon or Zin while keeping some piety.\n"
msgstr ""
"El Resplandeciente es una poderosa deidad en una cruzada contra todo mal. A sus\n"
"seguidores y aliados les puede conceder varias bendiciones mientras vayan\n"
"erradicando sin compasión a seres malignos e impíos, y se espera que prueben su\n"
"superioridad moral luchando honorablemente. A sus seguidores se les solicita\n"
"que limpien el mundo, examinando a todos sus habitantes en busca de rastros de\n"
"maldad que deba ser eliminada. Los seguidores de El Resplandeciente pueden\n"
"convertirse en seguidores de Elyvilon o de Zin conservando algo de piedad.\n"

#. key: trog
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:trog"
msgid ""
"Trog is an ancient god of anger and violence. Followers are expected to kill in\n"
"Trog's name, and especially to slay wizards. In return, worshippers of Trog\n"
"gain the ability to go berserk at will in combat, and will be granted\n"
"assistance in the form of powerful weapons and mighty allies. Followers are\n"
"absolutely forbidden the use of spell magic.\n"
msgstr ""
"Trog es un antiguo dios de furia y violencia. Sus seguidores han de matar en\n"
"nombre de Trog y sacrificar a los muertos para obtener poder durante las\n"
"batallas y ocasionalmente alguna recompensa. Quienes adoran a Trog pueden\n"
"entrar en un estado de furia a voluntad. Trog odia a todos los magos y le\n"
"encanta ver sus libros arder. Sus seguidores tienen prohibido el uso de\n"
"hechizos.\n"

#. key: vehumet
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:vehumet"
msgid ""
"Vehumet is a god of the destructive powers of magic. Followers will gain divine\n"
"assistance in commanding the hermetic arts, and the most favoured stand to gain\n"
"access to some of the fearsome spells in Vehumet's library. One's devotion to\n"
"Vehumet can be proven by the causing of as much carnage and destruction as\n"
"possible.\n"
msgstr ""
"Vehumet es un dios de los poderes destructivos de la magia. Los seguidores\n"
"ganan varios poderes útiles para mejorar su maestría en las artes herméticas y\n"
"los más favorecidos consiguen acceso a algunos de los terribles hechizos de la\n"
"biblioteca de Vehumet. La devoción a Vehumet se logra causando cuanta más\n"
"masacre y destrucción posible.\n"

#. key: xom
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:xom"
msgid ""
"Xom is a wild and unpredictable god of chaos, who seeks not worshippers but\n"
"playthings with which to toy. Many choose to follow Xom in the hope of\n"
"receiving fabulous rewards and mighty powers, but Xom is nothing if not\n"
"capricious. There is nothing a follower can do to influence Xom's mood.\n"
msgstr ""
"Xom es un dios extravagante e impredecible del caos, quien no busca seguidores,\n"
"sino juguetes con que jugar. Muchos deciden seguir a Xom con la esperanza de\n"
"recibir regalos fabulosos y grandes poderes, pero Xom es extremadamente\n"
"caprichoso. Nada de lo que hagan sus seguidores puede cambiar el humor de Xom.\n"

#. key: yredelemnul
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:yredelemnul"
msgid ""
"Cast down by the good gods eons ago, Yredelemnul seeks to despoil their\n"
"creations and chain all living souls within their inexorable grip. Followers who\n"
"would conquer in Yredelemnul's name are granted the power to reap an army of the\n"
"dead and bind powerful souls into eternal service - provided they can sweep\n"
"across the land in a tide as inexorable as their god.\n"
msgstr ""
"Yredelemnul el Oscuro es un dios malvado adorado por los que buscan poderes\n"
"sobre la muerte y los no-muertos. Los seguidores, que deben oponerse a todas\n"
"las cosas sagradas, pueden alzar legiones de serviles no-muertos, y ganar\n"
"varios poderes útiles (si bien desagradables). Yredelemnul aprecia las muertes,\n"
"pero prefiere que los cadáveres sean usados en lugar de sacrificados. Destruir\n"
"seres artificiales también se ve favorecido, ya que no son seres vivos ni\n"
"sujetos a la muerte o a la no-muerte.\n"

#. key: zin
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:zin"
msgid ""
"Zin is a god of discipline. Followers must remain pure of body and soul,\n"
"refraining from dark magic and chaotic acts. They must also tithe a fraction of\n"
"all gold gained, preferably followed by donations of more. In exchange,\n"
"worshippers may invoke Zin's wrath upon sinners, and eventually gain various\n"
"divine protections. Zin's followers can convert to Elyvilon or the Shining One\n"
"while keeping some piety.\n"
msgstr ""
"Zin es un dios de la disciplina. Sus seguidores deben permanecer puros de\n"
"cuerpo y alma, absteniéndose de magia oscura y actos caóticos, y nunca consumir\n"
"la carne de seres inteligentes. Ellos deben diezmar una fracción de todo el\n"
"dinero ganado, preferiblemente seguido de donaciones mayores. A cambio, sus\n"
"seguidores podrán invocar la ira de Zin contra los pecadores, y eventualmente\n"
"ganar varias protecciones divinas. Los seguidores de Zin se pueden convertir a\n"
"Elyvilon o a El Resplandeciente conservando una parte de su piedad.\n"

#. key: cheibriados powers
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:cheibriados powers"
msgid ""
"Followers of Cheibriados move more slowly as they gain favour. As they move\n"
"slower, worshippers of Cheibriados are granted increased attributes.\n"
"Cheibriados rewards the faithful with the power to slow other creatures and the\n"
"power to briefly distort the flow of time. Devout worshippers will gain the\n"
"ability to inflict great harm on all those who move more quickly than they do,\n"
"and finally the ability to step out of the flow of time entirely.\n"
msgstr ""
"Los seguidores de Cheibriados se mueven más lentamente a medida que ganan\n"
"favor, y son recompensados por matar a criaturas que sean más rápidas que\n"
"ellos. Moverse demasiado deprisa o usar armas mágicamente aceleradas está mal\n"
"visto. Cheibriados recompensa a los fieles con un metabolismo lento, el poder\n"
"de enlentecer a otras criaturas, el poder de distorsionar el flujo del tiempo,\n"
"el poder de dañar a aquellos que se muevan más deprisa que ellos y, finalmente,\n"
"la habilidad de abandonar el flujo del tiempo por completo.\n"

#. key: elyvilon powers
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:elyvilon powers"
msgid ""
"The Healer offers followers a number of means to heal themselves from damage\n"
"and other ill effects. Followers may also attempt to pacify hostile monsters\n"
"and turn them neutral. Elyvilon may directly intervene to save a follower's\n"
"life, and if there has been no such intervention recently, is sure to prevent\n"
"a killing blow against especially pious followers. Elyvilon may also\n"
"occasionally protect the follower's allies from death.\n"
msgstr ""
"Elyvilon ofrece a sus seguidores maneras de sanarse a sí mismos de heridas y de\n"
"otras aflicciones. Elyvilon también permite curar a monstruos hostiles para\n"
"tratar de volverlos neutrales. Elyvilon puede intervenir directamente para\n"
"salvar la vida de un seguidor, especialmente cuando es requerido para ello; los\n"
"seguidores altamente piadosos pueden estar seguros de dicha ayuda.\n"

#. key: fedhas powers
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:fedhas powers"
msgid ""
"Plants and fungi will not attack Fedhas' worshippers without provocation.\n"
"Worshippers may walk through plants or fungi, and even fire missiles or spells\n"
"through them without causing harm. Fedhas grants powers to temporarily grow a\n"
"menagerie of plant allies whose strength and duration increase with Invocations\n"
"skill. Worshippers may grow a protective wall of briar patches as well as\n"
"ballistomycetes that fire damaging spores whose explosions confuse living\n"
"creatures. Devout followers can overgrow a stretch of solid terrain with a\n"
"cluster of plant allies or even summon a mighty oklob plant.\n"
msgstr ""
"Las plantas y los hongos no atacarán a los adoradores de Fedhas sin provocación\n"
"previa. Los adoradores de Fedhas pueden caminar entre las plantas o los hongos,\n"
"e incluso lanzar proyectiles o hechizos a través de ellas sin causarles daño.\n"
"Fedhas confiere la habilidad de hacer evolucionar a las plantas y hongos en\n"
"especies más fuertes. Sus seguidores pueden eventualmente hacer crecer un muro\n"
"de plantas y crear esporas explosivas de los cadáveres. También se les concede\n"
"algo de control sobre el tiempo, siendo capaces de invocar luz solar y al\n"
"final, tormentas.\n"

#. key: vehumet powers
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:vehumet powers"
msgid ""
"Worshippers of Vehumet will quickly be able to recover their magical energy\n"
"upon killing beings. As they gain favour, they will also gain enhancements to\n"
"their destructive spells — first assistance in casting such spells and then\n"
"increased range for conjurations. Vehumet will offer followers the knowledge of\n"
"increasingly powerful destructive spells as they gain piety.\n"
msgstr ""
"Los adoradores de Vehumet pronto serán capaces de recuperar su mana matando\n"
"criaturas. A medida que ganen favor, también ganarán varias mejoras en sus\n"
"hechizos destructivos — en primer lugar, asistencia a la hora de recitar tales\n"
"hechizos; luego se incrementará la distancia de sus conjuros; y finalmente un\n"
"coste menor para lanzar hechizos destructivos de alto nivel.Con el tiempo,\n"
"Vehumet otorgará a sus seguidores raros libros de magia destructiva.\n"

#. key: xom powers
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:xom powers"
msgid ""
"To worship Xom is to live riskily. In a good mood Xom may shower worshippers\n"
"with gifts, while at other times this capricious god could decide to “spice\n"
"things up a little” and send worshippers to their doom. If such toys of Xom\n"
"prove to be interesting, so much the better; if not, well, there'll be other\n"
"playthings...\n"
msgstr ""
"Adorar a Xom es vivir con riesgo. De buen humor, Xom puede obsequiarte con una\n"
"lluvia de regalos, mientras que en otras ocasiones este dios caprichoso puede\n"
"decidir poner «algo de salsa» y acabar por condenarte. Si te muestras como el\n"
"más fuerte, tanto mejor; si no, bueno, siempre habrá otros con quien jugar...\n"

#. key: zin powers
#: dat/descript/gods.txt
msgctxt ""
"textdb:descriptions:zin powers"
msgid ""
"Zin grants followers the ability to preach to the unenlightened masses, and\n"
"powers to vitalise their bodies, protecting them from various afflictions.\n"
"Later, followers gain the ability to imprison their foes temporarily. Followers\n"
"can eventually find temporary safety in a divine refuge. As piety grows,\n"
"followers will be protected from mutation and the Hells, and Zin may even\n"
"occasionally directly intervene to save a follower's life.\n"
msgstr ""
"Zin concede a sus seguidores la habilidad de predicar a las masas, y poderes\n"
"para revitalizar sus cuerpos y ganar resistencia divina, protegiéndoles de\n"
"variadas aflicciones además de dar sustento al hambriento. Más adelante, sus\n"
"seguidores ganan la habilidad de aprisionar a sus enemigos de forma temporal.\n"
"Al final, sus seguidores pueden encontrar seguridad en un refugio divino por\n"
"algo de tiempo. A medida que la piedad crece, sus seguidores se verán\n"
"protegidos de mutaciones, y Zin puede incluso ocasionalmente intervenir de\n"
"forma directa para salvarle la vida a un seguidor.\n"

#. key: elven halls
#: dat/descript/branches.txt
msgctxt ""
"textdb:descriptions:elven halls"
msgid ""
"The Elven Halls are home to the deep elves, a race that turned their backs on\n"
"the sun long ago. Their halls are filled with riches, but a deadly welcome\n"
"awaits any would-be robbers. In their long seclusion, the deep elves have\n"
"perfected dark sorceries of a power the orcs can only dream of!\n"
msgstr ""
"Mientras que gran parte del pueblo elfo nunca se iría a un complejo oscuro y\n"
"subterráneo como éste, los elfos de las profundidades sí lo hicieron. Sus salas\n"
"están llenas de riquezas, pero cualquiera que pase por ellas debería estar\n"
"alerta ante las legendarias proezas mágicas de esta especie.\n"
"\n"
"Las Salas Élficas tienen tres niveles.\n"

#. key: lair
#: dat/descript/branches.txt
msgctxt ""
"textdb:descriptions:lair"
msgid ""
"Most adventurers find the Lair of Beasts to be an exciting change of climate.\n"
"And indeed, there is something to be said about getting gored, mauled and eaten\n"
"rather than sliced, burnt or stabbed.\n"
"\n"
"The Lair contains the entrances to one of the Swamp or the Shoals, one of the\n"
"Snake Pit or the Spider Nest, and to the Pits of Slime.\n"
msgstr ""
"Muchos aventureros encuentran que la Guarida de las Bestias es un excitante\n"
"cambio de clima. Y de hecho, tiene su aquél el ser corneado, aplastado y\n"
"devorado antes que cortado, quemado o apuñalado.\n"
"\n"
"La Guarida tiene cinco niveles y contiene las escaleras hacia tres ramas más:\n"
"uno a uno de los hoyo de serpientes o el nido de arañas, uno a uno de el ciénaga\n"
"o los bancos de arena y uno a los fosos cenagosos.\n"

#. key: snake pit
#: dat/descript/branches.txt
msgctxt ""
"textdb:descriptions:snake pit"
msgid ""
"The corridors of the Snake Pit are home to all varieties of serpent, and are\n"
"inhabited by a society of powerful nagas and salamanders.\n"
"\n"
"A dungeon features only one of the Snake Pit and Spider Nest branches.\n"
msgstr ""
"El Hoyo do Serpientes contiene serpientes de todas variedades. Sus corredores\n"
"albergan una sociedad de nagas poderosas y salamandras míticas.\n"
"\n"
"Una mazmorra solo contiene uno de la rama Hoyo de Serpientes y la rama Nido de Arañas.\n"

#. key: sewer
#: dat/descript/branches.txt
msgctxt ""
"textdb:descriptions:sewer"
msgid ""
"Every inhabited place needs to dispose of its waste products. The Dungeon too\n"
"has its stinking sewers and drains, full of filthy water and ignored by most\n"
"but used as hideaways by the disgusting and the desperate. Old tales speak of\n"
"dangerous creatures stalking through the foul-smelling green water, preying on\n"
"each other without mercy. The tales also allude to valuable items accidentally\n"
"washed into the drainage tunnels, forgotten and left to grow mouldy in the damp\n"
"caverns.\n"
msgstr ""
"Todos los emplazamientos conllevan desagradables alcantarillas y cloacas,\n"
"ignoradas por la mayoría pero que son escondrijos para otros. Viejos cuentos\n"
"hablan de peligrosas criaturas, bañándose en aguas verdosas de desagradable\n"
"olor, cazándose los unos a los otros sin piedad. Las historias también aluden a\n"
"valiosos objetos dejados por temerarios y desafortunados visitantes, criando\n"
"moho en las húmedas cuevas.\n"

#. key: volcano
#: dat/descript/branches.txt
msgctxt ""
"textdb:descriptions:volcano"
msgid ""
"Built from enormous blocks of obsidian, the volcano's sweltering chambers may\n"
"once have served as a temple to some strange deity, or perhaps the dwelling of\n"
"a mighty fire giant. The air shimmers with oppressive heat, and the dull roar\n"
"of the volcano's heart never ceases.\n"
msgstr ""
"Construida con enormes bloques de obsidiana, esta sofocante estancia puede\n"
"haber sido usada como templo a alguna extraña deidad, o quizás como la morada\n"
"de algún poderoso gigante de fuego. El aire se estremece con un calor opresivo,\n"
"y el ronco rugido del corazón del volcán nunca cesa.\n"

#. key: fighting
#: dat/descript/skills.txt
msgctxt ""
"textdb:descriptions:fighting"
msgid ""
"Fighting skill increases your accuracy and damage in physical combat, and\n"
"also increases your maximum health.\n"
msgstr ""
"La capacidad en Combate incrementa tu precisión y daño en combate cuerpo a\n"
"cuerpo, y también incrementa tu máximo de puntos de vida.\n"

#. key: throwing
#: dat/descript/skills.txt
msgctxt ""
"textdb:descriptions:throwing"
msgid ""
"Training Throwing will make thrown weapons (such as javelins) more accurate\n"
"and damaging. It also makes certain magical darts more likely to have an\n"
"effect.\n"
msgstr ""
"Entrenar Lanzar hará que las armas arrojadizas (como javalinas) y cerbatanas\n"
"sean más efectivas. En particular, hace que las armas de retorno sean más\n"
"proclives a regresar a su lanzador, y hace que ciertos dardos mágicos tengan un\n"
"efecto más probable cuando se lanzan con la cerbatana.\n"
"\n"
"Entrenarse en Lanzar le hace a uno más capaz con Hondas, y viceversa.\n"

#. key: armour
#: dat/descript/skills.txt
msgctxt ""
"textdb:descriptions:armour"
msgid ""
"Armour skill multiplies the AC gained from wearing armour of all kinds, both\n"
"from body armour and cloaks, gloves, etc. It also slightly lessens penalties\n"
"to spellcasting and ranged weapon speed from heavy armour.\n"
msgstr ""
"La capacidad en Armaduras incrementa el AC obtenido al llevar puestas\n"
"armaduras, y también ayuda a mitigar el lastre provocado por las armaduras\n"
"pesadas a la hora de combatir cuerpo a cuerpo o pronunciar hechizos.\n"

#. key: dodging
#: dat/descript/skills.txt
msgctxt ""
"textdb:descriptions:dodging"
msgid ""
"The Dodging skill will affect your chance of dodging an attack, be it melee,\n"
"ranged or magical. Certain types of attack cannot be dodged, however, such as\n"
"enchantments (which must be resisted with willpower) and explosions.\n"
msgstr ""
"La capacidad de Esquivar afectará a tus oportunidades de esquivar un ataque,\n"
"bien en cuerpo a cuerpo, a distancia o mágico. Ciertos tipos de ataque no\n"
"pueden esquivarse, como los encantamientos (que deben ser resistidos) o las\n"
"explosiones.\n"

#. key: shields
#: dat/descript/skills.txt
msgctxt ""
"textdb:descriptions:shields"
msgid ""
"A high Shields skill helps you block melee attacks or projectiles (both magical\n"
"and non-magical) with your equipped shield, and reduces their penalty to your\n"
"evasion, attack speed and spellcasting success.\n"
msgstr ""
"Un nivel alto de Escudos ayuda a detener ataques cuerpo a cuerpo o con\n"
"proyectiles (mágicos y no mágicos) con el escudo que lleves (que también puede\n"
"ser mágico o divino). Algunos ataques, como los virotes de penetración, no\n"
"pueden ser bloqueados de ningún modo.\n"

#. key: unarmed combat
#: dat/descript/skills.txt
msgctxt ""
"textdb:descriptions:unarmed combat"
msgid ""
"Being skilled in Unarmed Combat increases your accuracy, damage and attack\n"
"speed in melee combat when barehanded.\n"
msgstr ""
"Estar entrenado en Combate sin Armas incrementa la precisión, el daño y la\n"
"velocidad de ataque en el combate cuerpo a cuerpo cuando no se usen armas.\n"
"También permite golpear ocasionalmente con tu mano libre de forma adicional en\n"
"caso de poderse hacer.\n"

#. key: evocations
#: dat/descript/skills.txt
msgctxt ""
"textdb:descriptions:evocations"
msgid ""
"Evocations skill affects your ability to use magical items like wands and other\n"
"uncommon objects, increasing the power or success rate of such items.\n"
msgstr ""
"La capacidad en Evocaciónes afecta la compentencia de usar cosas mágicas como las\n"
"varas y otras cosas raras, aumentando la fuerza y probabilidad de éxito cuando\n"
"usandolas.\n"

#. key: no ability ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:no ability ability"
msgid ""
"If you get this description, it is a bug.\n"
msgstr ""
"Si lees esta descripción, ha ocurrido un error en el programa.\n"

#. key: spit poison ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:spit poison ability"
msgid ""
"Spits poison at a targeted creature.\n"
msgstr ""
"Escupes veneno al monstruo que apuntes.\n"

#. key: breathe fire ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:breathe fire ability"
msgid ""
"Breathes a blast of fire at a targeted creature.\n"
msgstr ""
"Exhalas una ráfaga de fuego al monstruo que apuntes.\n"

#. key: breathe poison gas ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:breathe poison gas ability"
msgid ""
"Breathes a blast of poison gas at a targeted creature.\n"
msgstr ""
"Exhalas una nube de gas venenoso al monstruo que apuntes.\n"

#. key: heal wounds ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:heal wounds ability"
msgid ""
"Heals the user significantly, with a chance of permanently reducing the user's\n"
"maximum magic capacity by one.\n"
msgstr ""
"Cura el usario considerablemente, con una posibilidad de reducando su magia máximo por uno.\n"

#. key: evoke berserk rage ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:evoke berserk rage ability"
msgid ""
"<Berserk ability>\n"
msgstr ""
"Te vuelves berserk. Entrar en trance berserk incrementa espectacularmente,\n"
"aunque por poco tiempo, tus puntos de vida y la capacidad de daño en el combate\n"
"cuerpo a cuerpo. Expirará rápidamente si no matas algo, pero puede extenderse\n"
"mediante múltiples muertes. Durante el trance berserk no puedes realizar\n"
"algunas acciones como, por ejemplo,(des)envainar un arma, beber, evocar varas u\n"
"otros artilugios, o  pronunciar hechizos. Tras este tipo de furia usualmente\n"
"uno queda profundamente exhausto, un periodo durante el que quedas ralentizado,\n"
"no puedes volverte berserk nuevamente y, ocasionalmente, incluso podrías\n"
"desmayarte.\n"

#. key: evoke invisibility ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:evoke invisibility ability"
msgid ""
"Turns the user invisible for a short period of time.\n"
msgstr ""
"Te vuelves invisible durante un tiempo limitado. Volverse invisible incrementa\n"
"tu contaminación mágica y puede finalmente causar brillo.\n"

#. key: end transformation ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:end transformation ability"
msgid ""
"Reverts you to your normal form.\n"
msgstr ""
"Recuperas tu forma normal, tras un leve retardo.\n"

#. key: vitalisation ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:vitalisation ability"
msgid ""
"Temporarily provides protection from poison, confusion, petrification, and\n"
"sickness, as well as the effects of clouds of foul pestilence. Your strength,\n"
"intelligence and dexterity are also temporarily increased by a degree dependent\n"
"on Invocations skill.\n"
msgstr ""
"Zin te aporta una resistencia divina y sustento. La resistencia divina te\n"
"protege de la enfermedad, de envenenamientos, petrificación, confusión y\n"
"descomposición, además de incrementar y mantener temporalmente tu Fuerza,\n"
"Inteligencia y Destreza.\n"

#. key: imprison ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:imprison ability"
msgid ""
"Temporarily imprisons a monster in walls of silver. The duration of the prison\n"
"is increased by Invocations skill.\n"
msgstr ""
"Encierra temporalmente a un enemigo en paredes de plata. La duración de la\n"
"prisión aumenta con las habilidades del invocador\n"

#. key: sanctuary ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:sanctuary ability"
msgid ""
"Transforms the area around the user into a domain of unbreakable law for a short\n"
"duration. So long as anyone stands within this sanctuary, no harm may be done to\n"
"them by others, and they may do no harm to others in turn.\n"
"\n"
"Beings with hostile intent are unable to enter a sanctuary and those already\n"
"nearby when it is created will be forced to flee.\n"
msgstr ""
"Por un breve espacio de tiempo estás a salvo en un refugio divino. Mientras\n"
"estés dentro del santuario los monstruos no te atacarán, pero la protección\n"
"desaparecerá en cuanto se acabe con la paz.\n"

#. key: cure all mutations ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:cure all mutations ability"
msgid ""
"Cures all your mutations — but only once.\n"
msgstr ""
"Se curan todas tus mutaciones — pero sólo por una vez.\n"

#. key: divine shield ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:divine shield ability"
msgid ""
"Manifests a blindingly bright shield in front of the user. Held aloft by the\n"
"Shining One's power, it will unerringly block the next several attacks which\n"
"could be blocked by a mundane shield. Ranged attacks will be reflected and melee\n"
"attackers have a chance of being briefly blinded by the resulting flash of\n"
"light.\n"
"\n"
"This shield will block only a limited number of attacks before vanishing, with\n"
"Invocations skill increasing how many.\n"
msgstr ""
"El Resplandeciente te concede un escudo divino. Dado que se mantiene por\n"
"poderes divinos no interfiere con tu equipación. Sin embargo está controlado\n"
"por tu voluntad y tu capacidad en Escudos lo mejorará.\n"

#. key: cleansing flame ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:cleansing flame ability"
msgid ""
"Invokes a huge blast of divine fury centered on the user, severely damaging\n"
"undead and demons and dealing damage to all other hostile creatures. The power\n"
"of the blast is increased by Invocations skill.\n"
msgstr ""
"Invocas una enorme llamarada de furia divina centrada en ti, dañando\n"
"severamente a los no-muertos y a los demonios. El resto de hostiles también se\n"
"ven afectados, aunque en menor medida, mientras que tus aliados y tú nunca os\n"
"veis afectados.\n"

#. key: summon divine warrior ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:summon divine warrior ability"
msgid ""
"Summons a powerful warrior against evil, either an angel or a daeva. The\n"
"duration of their assistance is increased by Invocations skill, and glory in\n"
"battle may lead the Shining One to bless them with an even longer stay.\n"
msgstr ""
"Convocas a un ángel o daeva, que son unos poderosos guerreros enfrentados al\n"
"mal. Pueden ser bendecidos por El Resplandeciente para permanecer más tiempo en\n"
"este mundo.\n"

#. key: recall undead harvest ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:recall undead harvest ability"
msgid ""
"Recalls your undead followers from anywhere in the dungeon to your immediate\n"
"surroundings.\n"
msgstr ""
"Llama a tus seguidores no muertos desde cualquier lugar de la mazmorra hasta ti\n"

#. key: bind soul ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:bind soul ability"
msgid ""
"Attempts to bind the soul of a living, holy, or demonic being into your eternal\n"
"service. If the targeted monster is slain before it leaves your sight, it will\n"
"return as a bound soul, retaining the equipment, spells and abilities it had in\n"
"life.\n"
"\n"
"Only beings who are relatively uninjured may be targeted, and the focus required\n"
"to keep their soul from escaping will consume 1/3 of the user's current health -\n"
"returning it only upon slaying them. The attempt will fail entirely if the\n"
"targeted monster leaves your sight before the process is complete.\n"
"\n"
"The bound soul's health is influenced by the user's Invocations skill. It will\n"
"follow its captor through stairs, and can be recalled from other levels.\n"
"\n"
"Only one soul can be bound at a time.\n"
msgstr ""
"Marcas el alma de un monstruo vivo y con inteligencia como lista para ser\n"
"tomada. Cuando el monstruo marcado muera, su alma será tuya.\n"
"\n"
"El alma esclavizada retendrá las facultades del monstruo, equipo y habilidades,\n"
"así como algo de su capacidad innata de curación. Sin embargo, solamente un\n"
"monstruo que esté poco herido puede tener su alma marcada y solamente se puede\n"
"esclavizar un alma cada vez. Además, la duración de la marca es dependiente del\n"
"nivel de Invocaciones.\n"
"\n"
"Las almas esclavizadas pueden seguirte más allá del nivel donde fueron creadas.\n"

#. key: heroism ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:heroism ability"
msgid ""
"Temporarily increases all of your combat skills, both offensive and defensive.\n"
"The duration is increased by Invocations skill.\n"
msgstr ""
"Temporalmente se incrementan todas tus capacidades de combate, incluyendo la\n"
"capacidad de pasar desapercibido o de evitar trampas.\n"

#. key: finesse ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:finesse ability"
msgid ""
"Greatly increases your combat speed. The duration is increased by Invocations\n"
"skill.\n"
msgstr ""
"Incrementas en gran medida tu velocidad de combate sin perder precisión. Este\n"
"efecto no natural causa pequeñas cantidades de contaminación mágica y la\n"
"exposición prolongada puede ser mala para tu salud.\n"

#. key: forget spell ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:forget spell ability"
msgid ""
"Removes a known spell from memory, so as to free memory to learn others.\n"
msgstr ""
"Olvidas cualquier hechizo de los que hayas memorizado, para poder liberar\n"
"memoria para aprender otros.\n"

#. key: berserk ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:berserk ability"
msgid ""
"Sends the user into a berserk rage. Going berserk temporarily increases health,\n"
"speed, and damage dealt in melee. It will time out quickly outside of combat,\n"
"but may be extended by multiple kills. While berserk, almost all actions other\n"
"than movement and melee combat are prevented. When the rage expires, the user\n"
"will be slowed and unable to berserk again for a short time.\n"
msgstr ""
"Te vuelves berserk. Entrar en trance berserk incrementa espectacularmente,\n"
"aunque por poco tiempo, tus puntos de vida y la capacidad de daño en el combate\n"
"cuerpo a cuerpo. Expirará rápidamente si no matas algo, pero puede extenderse\n"
"mediante múltiples muertes. Durante el trance berserk no puedes realizar\n"
"algunas acciones como, por ejemplo,(des)envainar un arma, beber, evocar varas u\n"
"otros artilugios, o  pronunciar hechizos. Tras este tipo de furia usualmente\n"
"uno queda profundamente exhausto, un periodo durante el que quedas ralentizado,\n"
"no puedes volverte berserk nuevamente y, ocasionalmente, incluso podrías\n"
"desmayarte.\n"

#. key: brothers in arms ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:brothers in arms ability"
msgid ""
"Summons huge angry allies to wreak havoc.\n"
msgstr ""
"Convocas a aliados enormes y furiosos para causar estragos.\n"

#. key: purification ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:purification ability"
msgid ""
"Purges your body of poison, confusion, slowness, petrification, weakness, and\n"
"sickness. Any drained maximum health will also be fully restored.\n"
msgstr ""
"Purgas tu cuerpo de todos los efectos nocivos como enfermedad, envenenamiento,\n"
"lentitud, petrificación, confusión y descomposición, y restauras completamente\n"
"tu Fuerza, Destreza e Inteligencia.\n"

#. key: depart the abyss ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:depart the abyss ability"
msgid ""
"Transports you out of the Abyss, returning you to the location from which you\n"
"entered it.\n"
msgstr ""
"Dejas el Abismo para regresar al lugar de donde viniste.\n"

#. key: banish ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:banish ability"
msgid ""
"Attempts to banish a creature into the Abyss. If the attempt succeeds, you gain\n"
"some piety and the creature's full experience value. Even creatures that resist\n"
"are left malmutated and weakened by the brush with the Abyss. Invocations skill\n"
"makes Banishment harder to resist.\n"
msgstr ""
"Intentas desterrar a un monstruo al Abismo.\n"

#. key: corrupt ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:corrupt ability"
msgid ""
"Corrupts the current level by unleashing Abyssal energies on it. This will\n"
"cause the area nearby to change appearance, and will gate in creatures from the\n"
"Abyss bent on causing destruction. This will not work on levels already\n"
"corrupted or in the Abyss itself. The size of the effect is increased by\n"
"Invocations skill.\n"
msgstr ""
"Corrompe el nivel actual liberando energías abismales en él. Esto causará que\n"
"el nivel cambie bastante en su aspecto y permitirá que accedan demonios del\n"
"Abismo para causar destrucción. Esto no funcionará en niveles ya corruptos o en\n"
"el propio Abismo.\n"

#. key: enter the abyss ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:enter the abyss ability"
msgid ""
"Transports you to Lugonu's realm instantly. The effort of even using the\n"
"ability will leave your health depleted.\n"
msgstr ""
"Te transportas al reino de Lugonu instantáneamente... a costa de reducir\n"
"permanentemente tus máximos de vida y magia. El esfuerzo asociado a esta\n"
"habilidad te vaciará de vida y magia.\n"

#. key: triple draw ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:triple draw ability"
msgid ""
"Draws three cards from any deck, and allows you to choose one to play,\n"
"discarding the other two.\n"
msgstr ""
"Sacas tres cartas de un mazo en tu inventario, las miras, y decides cual\n"
"conservar, descartando las otras dos.\n"

#. key: deal four ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:deal four ability"
msgid ""
"Plays four cards from a deck in the time it normally takes to draw a\n"
"single card.\n"
msgstr ""
"Extraes cuatro cartas de un mazo no marcado en el tiempo que normalmente\n"
"extraerías una. El resto del mazo es descartado. Si el mazo no contiene\n"
"suficientes cartas, Nemelex te dará una carta adicional, pero es posible no sea\n"
"de tu agrado.\n"

#. key: stack five ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:stack five ability"
msgid ""
"Draws five cards from your choice of decks, and allows you to sort them into\n"
"any order. Subsequently, you can draw these cards in the order you chose.\n"
"Re-using this ability will discard the current stack.\n"
msgstr ""
"Sacas cinco cartas de cualquier mazo no marcado de tu inventario, perdiendo el\n"
"resto de las cartas. Mira a las cartas y las reordenas de la forma que\n"
"prefieras. Por lo tanto, puedes sacar dichas cartas en el orden que elegiste.\n"

#. key: smiting ability
#. Preserve [[key]] references exactly.
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:smiting ability"
msgid ""
"[[Smiting spell]] The strength of the smiting is increased by Invocations skill.\n"
"\n"
"Beogh will not allow you to use this directly against another apostle during a\n"
"divine trial.\n"
msgstr ""
"Golpea a un enemigo dentro de tu campo de visión. Esto no requiere un camino\n"
"directo, simplemente viendo al enemigo es suficiente.\n"

#. key: bend time ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:bend time ability"
msgid ""
"Attempts to slow down everyone adjacent to you. High Invocations skill makes it\n"
"harder to resist.\n"
msgstr ""
"Intentas de ralentizar a cualquiera que este adyacente a ti. Un nivel alto en\n"
"Invocaciones lo hace más difícil de resistir.\n"

#. key: temporal distortion ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:temporal distortion ability"
msgid ""
"Warps the flow of time, causing monsters to skip forwards in time relative to\n"
"you.\n"
msgstr ""
"Distorsionas el flujo del tiempo a tu alrededor, causando que los monstruos\n"
"avancen en el tiempo relativo a ti.\n"

#. key: step from time ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:step from time ability"
msgid ""
"Removes you completely from the flow of time. Time will pass as it usually does,\n"
"and monsters will wander away and sometimes even fall back to sleep. After some\n"
"time has passed, you will return in the same state as the very second you\n"
"departed.\n"
"\n"
"Invocations skill increases the likelihood that your absence will have been so\n"
"long that alert monsters have fallen asleep again.\n"
msgstr ""
"Te excluyes del flujo del tiempo. Las cosas a tu alrededor sucederán a su\n"
"típico ritmo, los monstruos merodearán, los objetos perecederos se\n"
"descompondrán, las plantas crecerán. Tras algo de tiempo, volverás con el mismo\n"
"estado que tenías en el mismo segundo en que partiste.\n"

#. key: slimify ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:slimify ability"
msgid ""
"Coats a wielded weapon or your fists with slime, turning the next living or\n"
"corporeal undead monster hit into a neutral slime.\n"
msgstr ""
"Recubres el arma que empuñas, o tus propios puños, con baba, transformando al\n"
"siguiente ser vivo o no-muerto golpeado en una baba neutral.\n"

#. key: renounce religion ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:renounce religion ability"
msgid ""
"Renounces your faith. This will make you leave your god (and usually anger\n"
"said god).\n"
msgstr ""
"Renuncias a tu fe. Esto hará a tu personaje abandonar a su dios (y normalmente\n"
"enfadar a dicho dios).\n"

#. key: convert to beogh ability
#: dat/descript/ability.txt
msgctxt ""
"textdb:descriptions:convert to beogh ability"
msgid ""
"Swears fealty to Beogh, the god of cave orcs. This god demands that all\n"
"non-believers must die, but new believers must be spared and accepted into the\n"
"fold. Beware, for orcs who do not see you convert may still be hostile until\n"
"you have built your reputation!\n"
"\n"
"All other gods hate Beogh, and do not take desertion lightly.\n"
msgstr ""
"Juras lealtad a Beogh, el dios de la cueva de los orcos. Este dios exige que\n"
"todos los no-creyentes deben moriro, pero los nuevos creyentes deben ser\n"
"perdonados y aceptados en la grieta. Cuidado, aquellos orcos que no te hayan\n"
"visto convertirte pueden seguir sindo hostiles hasta que te hayas hecho una\n"
"reputación.\n"
"\n"
"Todos los demás dios odian a Beogh, y no se tomarán la deserción a la ligera.\n"

#. key: velocity card
#: dat/descript/cards.txt
msgctxt ""
"textdb:descriptions:velocity card"
msgid ""
"The card depicts an empty, well-worn pair of boots. Sand, ashes, and turf\n"
"coat the boots' soles.\n"
"\n"
"Drawing this card can grant great speed to allies or terrible slowness to foes.\n"
msgstr ""
"Esta tarjeta representa una par de botas vacías y raídas. Arena, ceniza y césped\n"
"cubren sus suelas.\n"
"\n"
"Sacar esta tarjeta puede aumentar la velocidad de los aliados del usuario o reducir\n"
"la velocidad de sus enmigos.\n"

#. key: the tomb card
#: dat/descript/cards.txt
msgctxt ""
"textdb:descriptions:the tomb card"
msgid ""
"The card depicts a royal crypt, its entrance sealed by a heavy stone slab.\n"
"\n"
"Drawing this card entombs its user in protective, temporary walls of solid rock.\n"
"At lower power levels or with adjacent creatures, the tomb may be imperfect.\n"
"\n"
"The tomb is sustained by the presence of its creator within it, and moving from\n"
"the centre of the tomb will cause its walls to crumble away.\n"
msgstr ""
"Esta carta representa una cripta real con su entrada sellada por una losa de piedra.\n"
"\n"
"Sacar esta carta rodeará al usuario de muros protectores y temporales.\n"
"A niveles de fuerza bajos, o con crituras contiguos, la tumba puede ser incompleta.\n"
"\n"
"La tumba es sostenida por el presencia de su creador, y moviéndose lejos del centro\n"
"provocará sus paredes desplomarse.\n"

#. key: exile card
#: dat/descript/cards.txt
msgctxt ""
"textdb:descriptions:exile card"
msgid ""
"The card depicts ceaseless hands from a yawning portal overcoming a panicked\n"
"figure.\n"
"\n"
"Drawing this card can banish nearby creatures to the abyss, with more being banished\n"
"at higher power levels. It will never banish the user.\n"
msgstr ""
"Esta tarjeta representa miles de manos alcanzando fuera de un portal enorme a una\n"
"figura aterrada\n"
"\n"
"Sacar esta carta desterrará a los enmigos cercanos, con más siendo desterrado a\n"
"niveles de fuerza más altos.\n"

#. key: the shaft card
#: dat/descript/cards.txt
msgctxt ""
"textdb:descriptions:the shaft card"
msgid ""
"The card depicts a traveller plummeting into a chasm that has opened beneath\n"
"them.\n"
"\n"
"Drawing this card will create a shaft beneath the user, and possibly beneath\n"
"their enemies.\n"
msgstr ""
"La carta representa un viajero caiéndose a una sima que ha abierto debajo del\n"
"viajero.\n"
"\n"
"Sacar esta carta abrirá una hoyo debajo del usuario, y posiblemente debajo de sus\n"
"enmigos.\n"

#. key: the elixir card
#: dat/descript/cards.txt
msgctxt ""
"textdb:descriptions:the elixir card"
msgid ""
"The card depicts a smug smile formed out of nine chalices.\n"
"\n"
"Drawing this card rapidly restores the user's health and magic.\n"
msgstr ""
"Una carta que representa una sonrisa presumida formada de nueve cálices.\n"
"\n"
"Sacar esta carta recuperará rápidamente la salud y las reservas de magia del\n"
"usuario.\n"

#. key: the cloud card
#: dat/descript/cards.txt
msgctxt ""
"textdb:descriptions:the cloud card"
msgid ""
"The card depicts an iron gate enshrouded in mist.\n"
"\n"
"Drawing this card enshrouds the user's foes in rings of detrimental clouds. The\n"
"effects of such clouds will vary with card power.\n"
msgstr ""
"La carta representa una puerta hierra rodeado de neblina.\n"
"\n"
"Sacar esta carta rodeará los enmigos del usuario por círculos de neblinas que\n"
"obstruen su visión.\n"
"La duración de las neblinas es aumenta con la fuerza de la carta.\n"

#. key: the swarm card
#: dat/descript/cards.txt
msgctxt ""
"textdb:descriptions:the swarm card"
msgid ""
"The card depicts a bear surrounded by a swarm of bees. It hums ominously.\n"
"\n"
"Drawing this card will summon bees.\n"
msgstr ""
"Esta carta representa un oso rodeada por una plaga de abejas. Resona siniestramente.\n"
"\n"
"Sacar esta carta convocará abejas.\n"

#. key: the wraith card
#: dat/descript/cards.txt
msgctxt ""
"textdb:descriptions:the wraith card"
msgid ""
"The card depicts absolutely nothing.\n"
"\n"
"Drawing this card will drain the user.\n"
msgstr ""
"Esta carta no representa nada\n"
"\n"
"Sacar esta carta drenará el usuario.\n"

#. key: a buggy card
#: dat/descript/cards.txt
msgctxt ""
"textdb:descriptions:a buggy card"
msgid ""
"The card depicts a Crawl player filing a bug report on Mantis.\n"
"\n"
"Drawing this card is a bug, if one ever encounters it as such.\n"
msgstr ""
"Buggy (es un bug si lees esto).\n"

#. key: a very buggy card
#: dat/descript/cards.txt
msgctxt ""
"textdb:descriptions:a very buggy card"
msgid ""
"The card depicts several Crawl players angrily filing several bug reports on\n"
"Mantis.\n"
"\n"
"Drawing this card is a bug, if one ever encounters it as such.\n"
msgstr ""
"Buggy (es un bug si lees esto).\n"

#. key: cmd_rest
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_rest"
msgid ""
"Rest and heal\n"
msgstr ""
"Descansar y curarse\n"

#. key: cmd_rest verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_rest verbose"
msgid ""
"Rests while your health and magic regenerate. Resting is interrupted as soon\n"
"as a hostile monster comes into view. If health and magic are both already\n"
"full, resting will wait for 100 turns.\n"
msgstr ""
"Pasas hasta 100 turnos para recuperar salud, recargar magia y/o buscar. El\n"
"descanso se interrumpe tan pronto como un monstruo hostil aparezca.\n"

#. key: cmd_explore
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_explore"
msgid ""
"Autoexplore the current level\n"
msgstr ""
"Autoexploración del nivel actual\n"

#. key: cmd_explore verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_explore verbose"
msgid ""
"Automatically explores the current level, collecting items on the way.\n"
"Exploration stops as soon as a hostile monster comes into view, or when you\n"
"encounter new items or features.\n"
msgstr ""
"Este comando te permite viajar en modo piloto automático hacia regiones\n"
"inexploradas del nivel actual, y tomar del suelo aquellos objetos que hayas\n"
"especificado para ser recogidos automáticamente. El viaje se detiene tan pronto\n"
"como un monstruo hostil aparezca, o cuando descubras objetos o estructuras\n"
"novedosas.\n"

#. key: cmd_interlevel_travel
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_interlevel_travel"
msgid ""
"Travel to distant levels\n"
msgstr ""
"Viajar entre niveles distantes\n"

#. key: cmd_interlevel_travel verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_interlevel_travel verbose"
msgid ""
"Automatically travels to a chosen level or branch. Travel is interrupted by\n"
"monsters coming into view.\n"
msgstr ""
"Viajas automáticamente entre niveles distantes. El viaje es interrumpido cuando\n"
"aparecen monstruos.\n"

#. key: cmd_use_ability
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_use_ability"
msgid ""
"Use divine, innate or evokable abilities\n"
msgstr ""
"Usar habilidades divinas o innatas\n"

#. key: cmd_search_stashes
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_search_stashes"
msgid ""
"Search for items/features\n"
msgstr ""
"Buscar objetos/estructuras\n"

#. key: cmd_search_stashes verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_search_stashes verbose"
msgid ""
"Searches for items or features seen elsewhere, and allows you to travel to\n"
"their location.\n"
msgstr ""
"Buscas objetos o estructuras que hayan aparecido en otra parte y viajas hasta\n"
"allí.\n"

#. key: cmd_replay_messages
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_replay_messages"
msgid ""
"Reread recent messages\n"
msgstr ""
"Releer mensajes recientes\n"

#. key: cmd_resists_screen
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_resists_screen"
msgid ""
"Display character overview\n"
msgstr ""
"Muestra un resumen del personaje\n"

#. key: cmd_resists_screen verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_resists_screen verbose"
msgid ""
"Displays an overview of your current resistances, abilities, equipment and\n"
"attributes.\n"
msgstr ""
"Muestra información sobre resistencias conocidas, habilidades, estadísticas del\n"
"equipo, etc.\n"

#. key: cmd_display_overmap
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_overmap"
msgid ""
"Display dungeon overview\n"
msgstr ""
"Mostrar el mapa del calabozo\n"

#. key: cmd_display_overmap verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_overmap verbose"
msgid ""
"Displays an overview of dungeon branch locations, discovered altars, shops and\n"
"level annotations.\n"
msgstr ""
"Muestra la localización de las entradas a las ramas del calabozo, tiendas y\n"
"otras estructuras que hayas encontrado.\n"

#. key: cmd_display_religion
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_religion"
msgid ""
"Display religious status\n"
msgstr ""
"Mostrar tu situación religiosa\n"

#. key: cmd_display_religion verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_religion verbose"
msgid ""
"Displays your god's likes and dislikes, conduct, and your current religious\n"
"standing and divine abilities.\n"
msgstr ""
"Muestra lo que gusta y disgusta a tu dios, la conducta a seguir y tu actual\n"
"nivel de religiosidad y habilidades divinas.\n"

#. key: cmd_display_mutations
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_mutations"
msgid ""
"Display mutations\n"
msgstr ""
"Mostrar las mutaciones\n"

#. key: cmd_display_skills
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_skills"
msgid ""
"Manage skills\n"
msgstr ""
"Administrar capacidades\n"

#. key: cmd_display_character_status
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_character_status"
msgid ""
"Display character status\n"
msgstr ""
"Mostrar el estado del personaje\n"

#. key: cmd_display_character_status verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_character_status verbose"
msgid ""
"Displays details on your current movement speed, attack speed, stealth, magic\n"
"resistance, and any currently active enchantments or status effects.\n"
msgstr ""
"Muestra los encantamientos activos y algunas cosas más.\n"

#. key: cmd_display_known_objects
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_known_objects"
msgid ""
"List discovered item types\n"
msgstr ""
"Lista de objetos descubiertos\n"

#. key: cmd_save_game_now
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_save_game_now"
msgid ""
"Save and exit\n"
msgstr ""
"Guardar la partida y salir\n"

#. key: cmd_save_game_now verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_save_game_now verbose"
msgid ""
"Saves the game for later and exits. Once you resume the game, the save file is\n"
"deleted again.\n"
msgstr ""
"Guarda el juego para más tarde y sale. Una vez reanudes el juego, el archivo\n"
"del juego guardado se vuelve a borrar.\n"

#. key: cmd_edit_player_tile
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_edit_player_tile"
msgid ""
"Modify the player tile\n"
msgstr ""
"Modificar el aspecto del jugador\n"

#. key: cmd_edit_player_tile verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_edit_player_tile verbose"
msgid ""
"Allows you to modify the equipment and species tile displayed in the player\n"
"doll.\n"
msgstr ""
"Modificas el aspecto del equipo y la especie mostrada en el jugador.\n"

#. key: cmd_display_commands
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_commands"
msgid ""
"Game help\n"
msgstr ""
"Ayuda del juego\n"

#. key: cmd_display_commands verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_commands verbose"
msgid ""
"Displays a list of commands.\n"
msgstr ""
"Lista de comandos y opciones, etc.\n"

#. key: cmd_autofight
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_autofight"
msgid ""
"Hit the closest monster\n"
msgstr ""
"Atacar al monstruo más cercano\n"

#. key: cmd_autofight verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_autofight verbose"
msgid ""
"Moves towards the closest hostile monster, or attacks an adjacent monster with\n"
"your current weapon.\n"
msgstr ""
"Te mueves hacia el monstruo hostil más cercano y lo atacas con el arma que\n"
"empuñes.\n"

#. key: cmd_autofight_nomove
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_autofight_nomove"
msgid ""
"Hit an adjacent monster\n"
msgstr ""
"Pegarle a un monstruo adyacente\n"

#. key: cmd_autofight_nomove verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_autofight_nomove verbose"
msgid ""
"Attacks an adjacent monster with your current weapon.\n"
msgstr ""
"Atacas a un monstruo adyacente a ti con el arma que empuñes.\n"

#. key: cmd_wait
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_wait"
msgid ""
"Wait a single turn\n"
msgstr ""
"Esperar un turno\n"

#. key: cmd_wait verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_wait verbose"
msgid ""
"Spends a single turn waiting and resting.\n"
msgstr ""
"Gastar un único turno esperando y descansando\n"

#. key: cmd_safe_wait
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_safe_wait"
msgid ""
"Wait a single turn if safe\n"
msgstr ""
"Esparar para una toca si estás seguro.\n"

#. key: cmd_safe_wait verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_safe_wait verbose"
msgid ""
"Spends a single turn waiting and resting, but only if there are no hostile\n"
"monsters in view.\n"
msgstr ""
"Pasar una toca para esparar y decansar, pero solo si no hay monstruos hostiles cercanos.\n"

#. key: cmd_display_inventory
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_inventory"
msgid ""
"Display the contents of your inventory\n"
msgstr ""
"Mostrar el contenido de tu inventario\n"

#. key: cmd_display_inventory verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_display_inventory verbose"
msgid ""
"Displays the contents of your inventory.\n"
msgstr ""
"Muestra el contenido de tu inventario.\n"

#. key: cmd_cast_spell
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_cast_spell"
msgid ""
"Cast a spell\n"
msgstr ""
"Pronunciar hechizo\n"

#. key: cmd_cast_spell verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_cast_spell verbose"
msgid ""
"Casts a spell.\n"
msgstr ""
"Pronuncias un hechizo.\n"

#. key: cmd_memorise_spell
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_memorise_spell"
msgid ""
"Memorise spell\n"
msgstr ""
"Memorizar hechizo\n"

#. key: cmd_memorise_spell verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_memorise_spell verbose"
msgid ""
"Memorises a chosen spell from your spell library.\n"
msgstr ""
"Pones en tu memoria un hechizo leído de un libro que poseas o sobre el que\n"
"estés.\n"

#. key: cmd_drop
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_drop"
msgid ""
"Drop items\n"
msgstr ""
"Depositar objetos\n"

#. key: cmd_drop verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_drop verbose"
