"Find stairs down\n"
msgstr ""
"Encontrar escaleras de bajada\n"

#. key: cmd_map_find_downstair verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_downstair verbose"
msgid ""
"Cycles through stairs down.\n"
msgstr ""
"Viajar a través de las escaleras de bajada\n"

#. key: cmd_map_find_you
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_you"
msgid ""
"Find me\n"
msgstr ""
"Encontrarme\n"

#. key: cmd_map_find_you verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_you verbose"
msgid ""
"Moves the map cursor back to your current position.\n"
msgstr ""
"Devolver el cursor del mapa de vuelta a tu posición\n"

#. key: cmd_map_find_portal
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_portal"
msgid ""
"Find shops and portals\n"
msgstr ""
"Encontrar tiendas y portales\n"

#. key: cmd_map_find_portal verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_portal verbose"
msgid ""
"Cycles through shops and portals on the current level.\n"
msgstr ""
"Viajar a través de las tiendas y los portales del nivel actual\n"

#. key: cmd_map_find_trap
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_trap"
msgid ""
"Find traps\n"
msgstr ""
"Encontrar trampas\n"

#. key: cmd_map_find_trap verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_trap verbose"
msgid ""
"Cycles through traps on the current level.\n"
msgstr ""
"Viajar a través de las trampas del nivel actual\n"

#. key: cmd_map_find_altar
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_altar"
msgid ""
"Find altars\n"
msgstr ""
"Encontrar altares\n"

#. key: cmd_map_find_altar verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_altar verbose"
msgid ""
"Cycles through altars on the current level.\n"
msgstr ""
"Viajar por los altalres del nivel actual\n"

#. key: cmd_map_find_excluded
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_excluded"
msgid ""
"Find travel exclusion\n"
msgstr ""
"Encontrar zonas de exclusión de paso\n"

#. key: cmd_map_find_excluded verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_excluded verbose"
msgid ""
"Cycles through travel exclusions on the current level.\n"
msgstr ""
"Viajar a través de las zonas de exclusión de paso del nivel actual\n"

#. key: cmd_map_find_waypoint
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_waypoint"
msgid ""
"Find waypoint\n"
msgstr ""
"Encontrar marcadores\n"

#. key: cmd_map_find_waypoint verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_waypoint verbose"
msgid ""
"Cycles through all waypoints on the current level.\n"
msgstr ""
"Viajar a través de los marcadores del nivel actual\n"

#. key: cmd_map_find_stash
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_stash"
msgid ""
"Find stash\n"
msgstr ""
"Encontrar alijos\n"

#. key: cmd_map_find_stash verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_map_find_stash verbose"
msgid ""
"Cycles through all stashes on the current level.\n"
msgstr ""
"Viajar a través de los alijos del nivel actual\n"

#. key: cmd_zoom_in
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_zoom_in"
msgid ""
"Zoom in\n"
msgstr ""
"Acercar zoom\n"

#. key: cmd_zoom_in verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_zoom_in verbose"
msgid ""
"Zooms in on dungeon area.\n"
msgstr ""
"Acercar el zoom a la zona de la mazmorra\n"

#. key: cmd_zoom_out
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_zoom_out"
msgid ""
"Zoom out\n"
msgstr ""
"Alejar el zoom\n"

#. key: cmd_zoom_out verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_zoom_out verbose"
msgid ""
"Zooms out on dungeon area.\n"
msgstr ""
"Alejar el zoom de la zona de la mazmorra\n"

#. key: fragile as glass monstatus
#: dat/descript/monstatus.txt
msgctxt ""
"textdb:descriptions:fragile as glass monstatus"
msgid ""
"This creature receives 50% more damage from all sources.\n"
msgstr ""
"Esta critura recibe 50% más daño de todo.\n"

#. key: sick monstatus
#: dat/descript/monstatus.txt
msgctxt ""
"textdb:descriptions:sick monstatus"
msgid ""
"This creature is sick and cannot naturally regenerate.\n"
msgstr ""
"Esta critura está enfermo y no puede regenerarse naturalmente.\n"

#. key: skewered by barbs monstatus
#: dat/descript/monstatus.txt
msgctxt ""
"textdb:descriptions:skewered by barbs monstatus"
msgid ""
"This creature will take minor damage whenever it moves.\n"
msgstr ""
"Esta critura recibirá una cantidad de daño pequeña cada vez que se mueve.\n"

#. key: slow monstatus
#: dat/descript/monstatus.txt
msgctxt ""
"textdb:descriptions:slow monstatus"
msgid ""
"This creature moves and acts at 66% of normal speed.\n"
msgstr ""
"Esta critura se mueve y actúa al 66% de su velocidad normal.\n"

#. key: strong monstatus
#: dat/descript/monstatus.txt
msgctxt ""
"textdb:descriptions:strong monstatus"
msgid ""
"This creature's melee attacks deal 50% more damage.\n"
msgstr ""
"Los ataques de esta critura hacen 50% más daño.\n"

#. key: unrewarding monstatus
#: dat/descript/monstatus.txt
msgctxt ""
"textdb:descriptions:unrewarding monstatus"
msgid ""
"This creature provides no experience or piety when slain.\n"
msgstr ""
"Esta critura no te dará ninguna experiencia ni piedad cuando muere.\n"

#. key: weak monstatus
#: dat/descript/monstatus.txt
msgctxt ""
"textdb:descriptions:weak monstatus"
msgid ""
"This creature's melee attacks deal 33% less damage.\n"
msgstr ""
"Los ataques de esta critura hacen 33% menos daño.\n"

#. key: steam resistance mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:steam resistance mutation"
msgid ""
"You are immune to the damage from steam breath and steam clouds.\n"
msgstr ""
"No recibes daño por exhalaciones ni nubes de vapor hirviente.\n"

#. key: poison resistance mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:poison resistance mutation"
msgid ""
"You resist poisons, toxins and other contaminants. This does not confer\n"
"full immunity, but reduces your chances of being affected to roughly\n"
"one-third what it would be otherwise.\n"
msgstr ""
"Tienes resistencia al veneno. No tienes immunidad, pero reduce la probabilidad de\n"
"tú estando affectado por lo a un tercio de que sería sin esta mutación.\n"

#. key: fire resistance mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:fire resistance mutation"
msgid ""
"You resist heat. Each level of this mutation reduces the amount of damage taken\n"
"from fire.\n"
msgstr ""
"Tienes resistencia al fuego. Cada nivel de esta mutación reduce el daño que recibes\n"
"por el fuego.\n"

#. key: cold resistance mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:cold resistance mutation"
msgid ""
"You resist cold. Each level of this mutation reduces the amount of damage taken\n"
"from cold.\n"
msgstr ""
"Tienes resistencia al frío. Cada nivel de esta mutación reduce el daño que recibes\n"
"por el frío.\n"

#. key: electricity resistance mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:electricity resistance mutation"
msgid ""
"You resist electricity (rElec), taking less damage from it.\n"
msgstr ""
"Tienes resistencia a la electricidad y recibes menos daño por la.\n"

#. key: sense surroundings mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:sense surroundings mutation"
msgid ""
"You have a second sense for the dungeon, allowing you to sense terrain you\n"
"haven't yet seen. Each level of this mutation allows you to sense more and\n"
"more thoroughly.\n"
msgstr ""
"Tienes un sexto sentido para la mazmorra, permitiéndote sentir terreno que no has\n"
"visto. Cada nivel de esta mutación permites sentir más y más completamente.\n"

#. key: no potions mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:no potions mutation"
msgid ""
"You are unable to quaff potions.\n"
msgstr ""
"No puedes beber pociones\n"

#. key: no armour mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:no armour mutation"
msgid ""
"You cannot wear armour.\n"
msgstr ""
"No puedes llevar armaduras.\n"

#. key: inability to train dodging mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:inability to train dodging mutation"
msgid ""
"Your Dodging skill is 0 and you cannot train the skill.\n"
msgstr ""
"Tu capacidad de Esquivar es cero, y no puedes aumentarlo.\n"

#. key: inability to train armour mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:inability to train armour mutation"
msgid ""
"Your Armour skill is 0 and you cannot train the skill.\n"
msgstr ""
"Tu capacidad en Armaduras es cero, y no puedes aumentarlo.\n"

#. key: no air magic mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:no air magic mutation"
msgid ""
"Your Air Magic skill is 0 and you cannot train the skill.\n"
msgstr ""
"Tu habilidad de Magia de Aire es cero, y no puedes aumentarlo.\n"

#. key: no conjurations magic mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:no conjurations magic mutation"
msgid ""
"Your Conjurations skill is 0 and you cannot train the skill.\n"
msgstr ""
"Tu habilidad de Conjuros es cero, y no puedes aumentarlo.\n"

#. key: no earth magic mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:no earth magic mutation"
msgid ""
"Your Earth Magic skill is 0 and you cannot train the skill.\n"
msgstr ""
"Tu habilidad de Magia de Tierra es cero, y no puedes aumentarlo.\n"

#. key: no fire magic mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:no fire magic mutation"
msgid ""
"Your Fire Magic skill is 0 and you cannot train the skill.\n"
msgstr ""
"Tu habilidad de Magia de Fuego es cero, y no puedes aumentarlo.\n"

#. key: no ice magic mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:no ice magic mutation"
msgid ""
"Your Ice Magic skill is 0 and you cannot train the skill.\n"
msgstr ""
"Tu habilidad de Magia de Hielo es cero, y no puedes aumentarlo.\n"

#. key: no alchemy magic mutation
#: dat/descript/mutations.txt
msgctxt ""
"textdb:descriptions:no alchemy magic mutation"
msgid ""
"Your Alchemy skill is 0 and you cannot train the skill.\n"
msgstr ""
"Tu habilidad de Alquimia es cero, y no puedes aumentarlo.\n"

#. key: no spellcasting passive
#: dat/descript/passives.txt
msgctxt ""
"textdb:descriptions:no spellcasting passive"
msgid ""
"You cannot cast spells.\n"
msgstr ""
"No puedes lanzar hechizos.\n"

#. key: corrode self passive
#: dat/descript/passives.txt
msgctxt ""
"textdb:descriptions:corrode self passive"
msgid ""
"You have a chance of being corroded when you take damage.\n"
msgstr ""
"Cada vez que recibes daño tienes posibilidad de carcomer.\n"

#. key: slow self passive
#: dat/descript/passives.txt
msgctxt ""
"textdb:descriptions:slow self passive"
msgid ""
"You have a chance of being slowed when you take damage.\n"
msgstr ""
"Cada vez que recibes daño tienes posibilidad de lentificar.\n"

#. key: harm passive
#: dat/descript/passives.txt
msgctxt ""
"textdb:descriptions:harm passive"
msgid ""
"Any damage you deal or take is increased.\n"
msgstr ""
"Todo daño recibes o haces es aumentado.\n"

#. key: guardian spirit passive
#: dat/descript/passives.txt
msgctxt ""
"textdb:descriptions:guardian spirit passive"
msgid ""
"Any damage you take is divided between your reserves of health and magic.\n"
msgstr ""
"Tu reserva de magia absorbe una parte del daño que recibes.\n"

#. key: archmagi passive
#: dat/descript/passives.txt
msgctxt ""
"textdb:descriptions:archmagi passive"
msgid ""
"Your spell power is increased.\n"
msgstr ""
"Tu poder de hechizos es aumentado.\n"

#. key: deep elf
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:deep elf"
msgid ""
"Deep Elves have a strong affinity for all kinds of magic, but are very fragile.\n"
"They regenerate magical power rapidly.\n"
msgstr ""
"Los elfos más afines a la magia, pero también los más frágiles.\n"

#. key: demigod
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:demigod"
msgid ""
"Demigods refuse to worship any god, but make up for this with divine attributes\n"
"and high reserves of health and magic.\n"
msgstr ""
"Nunca siguen a un dios, pero los semidioses lo compensan con atributos divinos\n"
"y vitalidad.\n"

#. key: demonspawn
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:demonspawn"
msgid ""
"Demonspawn are half human, half demon. They acquire strong demonic mutations as\n"
"they grow.\n"
msgstr ""
"Los semidemonios son medio humano, medio demonio. Adquieren poderosas\n"
"mutaciones demoníacas a medida que se desarrollan.\n"

#. key: djinni
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:djinni"
msgid ""
"Djinn are ever-burning spirits. They learn spells automatically as they grow,\n"
"and cast by drawing down their own fires.\n"
msgstr ""
"Los genios son espíritus siempre-quemándose. Aprenden hechizos sin libros y\n"
"lanzarlos por usando sus propios fuegos.\n"

#. key: draconian
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:draconian"
msgid ""
"Draconians are versatile hybrids. They mature when reaching level 7 and develop\n"
"a colour.\n"
msgstr ""
"Los draconianos son híbridos versátiles. Alcanzan la madurez en el nivel 7 y\n"
"desarrollan un color.\n"

#. key: felid
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:felid"
msgid ""
"Felids are many-lived sentient cats. They cannot use armour or weapons.\n"
msgstr ""
"Estos gatos tienen muchas vidas y son sentientes, pero son incapaces de manipular\n"
"objetos de una forma avanzada o de usar armaduras o armas.\n"

#. key: gargoyle
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:gargoyle"
msgid ""
"Made of living stone, Gargoyles have a preternatural affinity for earth magic.\n"
"They have low health, but their stone bodies are incredibly tough.\n"
msgstr ""
"Hechos de piedra viviendo, gárgolas son en sintonía con la tierra. Tienen salud\n"
"baja, pero sus cuerpos son incredíblemente duros.\n"

#. key: human
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:human"
msgid ""
"Humans are natural explorers. Discovering new places refreshes and invigorates them.\n"
"They are otherwise completely average.\n"
msgstr ""
"Mundanos y en la media.\n"

#. key: tengu
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:tengu"
msgid ""
"Tengu are bird-people who love to fight, both with weapons and spells. They are\n"
"fragile but agile, and eventually learn to fly.\n"
msgstr ""
"Gente-pájaro con gusto por el combate, tanto con armas como con hechizos.\n"
"Inicialmente son algo frágiles, pero más tarde aprenden a volar.\n"

#. key: merfolk
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:merfolk"
msgid ""
"Half fish, half human, Merfolk are citizens of both water and land. They are\n"
"strong combatants, and adept at using magic to assist in battle.\n"
msgstr ""
"Medio pez, medio humanos, los tritones y sirenas son ciudadanos tanto del agua\n"
"como de la tierra.\n"

#. key: minotaur
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:minotaur"
msgid ""
"Minotaurs are large muscular humans with bovine heads. They excel at all forms\n"
"of close and ranged combat.\n"
msgstr ""
"Un humanoide grande y musculoso con la cabeza de un toro. Son excelentes en\n"
"cualquier forma de combate, tanto cuerpo a cuerpo como a distancia.\n"

#. key: mummy
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:mummy"
msgid ""
"Compelled to walk by an ancient curse, Mummies have innate faith and are adept\n"
"at Necromancy, but learn other skills very slowly. They cannot drink potions.\n"
msgstr ""
"Una figura no-muerta cubierta en vendas y fluidos de embalsamado, obligada a\n"
"caminar por una antigua maldición. Tienen fe innata y son expertas en nigromancia,\n"
"pero aprenden otras habilidades lentamente. No pueden beber pociones.\n"

#. key: naga
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:naga"
msgid ""
"Nagas are hybrids: human from the waist up, with a snake-like tail instead of\n"
"legs. They move very slowly but are naturally resilient.\n"
msgstr ""
"Un híbrido; humanos de pecho hacia arriba, con un tronco escamoso y muscular\n"
"como el de una serpiente.\n"

#. key: octopode
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:octopode"
msgid ""
"Octopodes are a species of amphibious cephalopods. They can wear eight rings,\n"
"but almost no armour fits them.\n"
msgstr ""
"Una especie de cefalópodo anfibio. Pueden llevar puesto ocho anillos, pero\n"
"prácticamente no hay armadura que les sirva.\n"

#. key: spriggan
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:spriggan"
msgid ""
"Very small, very frail and very fast, Spriggans are highly competent stabbers\n"
"and spellcasters.\n"
msgstr ""
"Muy pequeños, muy delicados y muy rápidos. Los spriggans son muy competentes\n"
"apuñalando y lanzando hechizos.\n"

#. key: troll
#: dat/descript/species.txt
msgctxt ""
"textdb:gamestart:troll"
msgid ""
"Trolls are monstrous creatures with powerful claws. They regenerate health\n"
"rapidly.\n"
msgstr ""
"Grandes brutos, listos para descuartizar cualquier cosa con sus garras, nunca\n"
"pensándoselo dos veces. Siempre están hambrientos.\n"

#. key: air elementalist
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:air elementalist"
msgid ""
"Air Elementalists have learned the Shock spell. Their electrical magic can harm\n"
"groups of foes, while their air spells assist in fighting or fleeing enemies.\n"
msgstr ""
"Los Elementalistas del Aire han aprendido el hechizo de la Descarga. Más\n"
"adelante, su Libro del Aire les provee de flexibilidad para sobrevivir.\n"

#. key: artificer
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:artificer"
msgid ""
"Artificers start with a few magic wands and a club. They'll need to find better\n"
"weapons and armour before their wands run out.\n"
msgstr ""
"Los Artificieros comienzan con unos pocos instrumentos mágicos y son\n"
"competentes usando dichas herramientas.\n"

#. key: berserker
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:berserker"
msgid ""
"Berserkers believe in Trog, the magic-hating god of frenzy. Not much can stop a\n"
"raging berserker early on, apart from hubris.\n"
msgstr ""
"Los Berserkers creen en Trog, el dios del delirio y enemigo de la magia. No hay\n"
"mucho que pueda detener a un berserk furioso al principio, salvo el\n"
"sobreestimar sus capacidades.\n"

#. key: brigand
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:brigand"
msgid ""
"Brigands carry poisoned darts and a small number of nasty curare darts.\n"
msgstr ""
"Los Bandoleros llevan dardos venenosos y unos pocos de la tipo curare consigo.\n"
"También tienen una daga encantada.\n"

#. key: chaos knight
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:chaos knight"
msgid ""
"Chaos Knights are playthings of the unpredictable Xom, and are subject to the\n"
"god's constantly changing moods.\n"
msgstr ""
"Los Caballeros Caóticos son juguetes del impredecible Xom, y están sujetos a\n"
"los constantes cambios de humor del dios.\n"

#. key: cinder acolyte
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:cinder acolyte"
msgid ""
"Cinder Acolytes worship Ignis, drawing upon the flame of a dying god until\n"
"there is nothing left. They have both melee and fire magic capabilities.\n"
msgstr ""
"Los Discípulos Cenizas adoran a Ignis. Ellos recurren a la flama de un dios\n"
"agonizante hasta no hay nada que permanecer. Tienen capacidades dos las de cuerpo\n"
"a cuerpo y de magia fuego.\n"

#. key: conjurer
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:conjurer"
msgid ""
"Conjurers begin with the Magic Dart spell, and can learn other non-elemental\n"
"spells to reliably blast their foes.\n"
msgstr ""
"Los Conjuradores afrontan los problemas con hechizos destructivos. Ellos empiezan con\n"
"el hechizo Dardo Magicó y pueden aprender otros hechizos sin elementos para matar a\n"
"sus enmigos\n"

#. key: delver
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:delver"
msgid ""
"Delvers start their quest five levels below the surface. A set of powerful magic\n"
"items helps them survive the dangerous journey upward.\n"
msgstr ""
"Los espeleólogos empiezan su aventura cinco pisos debajo de la superficie. Tienen unas\n"
"cosas mágicas para ayudarles sobrevivir la subida.\n"

#. key: earth elementalist
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:earth elementalist"
msgid ""
"Earth Elementalists know the Sandblast spell, and can later learn more earthen\n"
"spells suitable for subtle stabbing or brute-force blasting.\n"
msgstr ""
"Los Elementalistas de la Tierra conocen el hechizo del Golpe de Arena, y tienen\n"
"piedras para incrementar el poder del hechizo. Más hechizos de tierra están en\n"
"su Libro de Geomancia.\n"

#. key: enchanter
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:enchanter"
msgid ""
"Enchanters know a variety of Hexes that can incapacitate their foes, and are\n"
"equipped with an enchanted dagger and potions of invisibility.\n"
msgstr ""
"Los Encantadores usan hechizos para potenciarse en batalla o bien para\n"
"incapacitar a otros. También comienzan con una daga encantada y unas pociones\n"
"de invisibilidad.\n"

#. key: fire elementalist
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:fire elementalist"
msgid ""
"Fire Elementalists have learned the Foxfire spell. Their other starting spells\n"
"are likewise focused on fiery and explosive destruction.\n"
msgstr ""
"Los Elementalistas de Fuego comienzan con el Libro de las Llamas y conocen el\n"
"hechizo Lengua de Fuego. Los otros hechizos en su libro se enfocan en\n"
"destrucción también.\n"

#. key: gladiator
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:gladiator"
msgid ""
"Gladiators are ready for the arena with light armour, a weapon of their choice,\n"
"and a few throwing weapons and nets.\n"
msgstr ""
"Los Gladiadores salen listos para la arena con una armadura ligera, escudo,\n"
"redes y un arma de su elección.\n"

#. key: hedge wizard
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:hedge wizard"
msgid ""
"Hedge Wizards are magic generalists, good at using a wide variety of tools to\n"
"frustrate their foes and gain an edge in the battlefield.\n"
msgstr ""
"Los magos comienzan con una amplia gama de hechizos menores que pueden usar para\n"
"frustuar sus enmigos y obtener una ventaja en batalla.\n"

#. key: hunter
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:hunter"
msgid ""
"Hunters carry a shortbow, light armour and a scroll of butterflies.\n"
msgstr ""
"Los Cazadores son capaces de atacar a distancia, sin usar la dichosa magia.\n"
"Ellos empiezan con un arco corto, armadura liviano y un pergamino de\n"
"mariposas.\n"

#. key: ice elementalist
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:ice elementalist"
msgid ""
"Ice Elementalists begin with the Freeze spell. Their later spells provide strong\n"
"offence and defence, but may restrict their movement.\n"
msgstr ""
"Los Elementalistas del Hielo empiezan con el Libro de la Escarcha y el hechizo\n"
"Helar. El resto de hechizos son bastante versátiles.\n"

#. key: monk
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:monk"
msgid ""
"Monks start with a simple weapon of their choice, an orb of light, and a potion\n"
"of divine ambrosia, and gain additional piety with the first god they worship.\n"
msgstr ""
"Los Monjes están preparados para enfrentarse a lo que sea en el Calabozo\n"
"simplemente con una túnica y usando su cuerpo.\n"

#. key: necromancer
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:necromancer"
msgid ""
"Necromancers start out with the Soul Splinter spell. Eventually, they can turn\n"
"the dead into allies and use the life force of the living to restore themselves.\n"
msgstr ""
"Los Nigromantes son magos especializados en la práctica de la magia de la\n"
"muerte. Empiezan con el hechizo del Dolor.\n"

#. key: summoner
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:summoner"
msgid ""
"Summoners are able to cast Summon Small Mammal from the start, and begin with\n"
"spells to summon stronger and more exotic allies in their library.\n"
msgstr ""
"Los Convocadores son capaces de Convocar a Pequeño Mamífero desde el inicio\n"
"y comienzan con hechizos para llamar aliados más fuerzas y exóticos en su biblioteca.\n"

#. key: alchemist
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:alchemist"
msgid ""
"Alchemists start with the Poisonous Vapours spell, and their magic is very\n"
"effective against foes susceptible to poison.\n"
msgstr ""
"Los Alquimistas comienzan con el hechizo Vapors Envenenadores. Sus hechizos son\n"
"muy eficaces contra los monstruos sin progencia contra los effectos de veneno.\n"

#. key: wanderer
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:wanderer"
msgid ""
"Wanderers start with random equipment and skills.\n"
msgstr ""
"Los Viajeros comienzan con capacidades y una equipación al azar.\n"

#. key: warper
#: dat/descript/backgrounds.txt
msgctxt ""
"textdb:gamestart:warper"
msgid ""
"Warpers start with a weapon of their choice, a scroll of blinking, darts of\n"
"disjunction, and some Translocation spells in their library.\n"
msgstr ""
"Los urdidores comienzan con un arma de que hayan elegido y un pergamino de\n"
"«Blinking». Pueden aprender los hechizos contenidos en el libro de\n"
"Translocaciones Espaciales.\n"

#. key: tutorial intro
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial intro"
msgid ""
"You can reread all messages at any time with\n"
"<input>$cmd[CMD_REPLAY_MESSAGES]</input>. Also, press <input>Space</input>\n"
"<localtiles> or <input>left click</input> with mouse</localtiles> to clear the\n"
"<cyan>--more--</cyan> prompts.\n"
msgstr ""
"Puedes volver a leer los mensajes en cualquier momento mediante\n"
"<input>$cmd[CMD_REPLAY_MESSAGES]</input>. Pulsa la tecla <input>Espacio</input>\n"
"para marcar como leídas las notificaciones <cyan>--more--</cyan> que aparezcan.\n"

#. key: tutorial1 start
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial1 start"
msgid ""
"In this lesson you're going to learn how to move around and explore a level.\n"
"You can move <localtiles>by clicking somewhere with your <input>Mouse</input>,\n"
"or </localtiles>with the <input>arrow keys</input>.\n"
msgstr ""
"En esta lección vas a aprender a moverte en el juego y como explorar un nivel.\n"
"Puedes moverte <localtiles>haciendo clic en algún lugar con tu\n"
"<input>Ratón</input>, o </localtiles>pulsando las <input>teclas de\n"
"dirección</input>.\n"

#. key: tutorial1 go_on
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial1 go_on"
msgid ""
"You're doing great! Now, explore a bit until you reach the next blue square.\n"
msgstr ""
"¡Lo estás haciendo muy bien! Ahora, explora un poco hasta que llegues al\n"
"siguiente cuadrado azul.\n"

#. key: tutorial1 downstairs
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial1 downstairs"
msgid ""
"When standing on a staircase leading downwards, you can enter the next level\n"
"with <input>$cmd[CMD_GO_DOWNSTAIRS]</input><localtiles> or with\n"
"a <input>left click</input> on your character</localtiles>.\n"
msgstr ""
"Cuando estés sobre unas escaleras descendentes, puedes pasar al siguiente nivel\n"
"mediante <input>$cmd[CMD_GO_DOWNSTAIRS]</input><localtiles> o haciendo\n"
"<input>Shift-clic</input> sobre tu personaje</localtiles>.\n"

#. key: tutorial1 autoexplore
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial1 autoexplore"
msgid ""
"Exploring manually can get tedious after a while, so you might want to let that\n"
"happen automatically. Try it by pressing <input>$cmd[CMD_EXPLORE]</input>\n"
"<localtiles>, or by clicking on 'autoexplore', the first button in the command\n"
"bar below the minimap.</localtiles>.\n"
msgstr ""
"Explorar manualmente puede volverse tedioso después de un rato, así que también\n"
"es posible hacerlo de una forma automática. Prueba a pulsar la tecla\n"
"<input>$cmd[CMD_EXPLORE]</input>.\n"

#. key: tutorial1 exclusion
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial1 exclusion"
msgid ""
"Some dangerous ground is marked with <w>exclusions</w>. Autotravel\n"
"<localtiles>(including <input>mouseclick</input>!) </localtiles>will not lead\n"
"you into exclusions. Instead you will automatically stop.\n"
"\n"
"However, autoexplore will move you safely around exclusions: so, you can safely\n"
"continue by pressing <input>$cmd[CMD_EXPLORE]</input>.\n"
msgstr ""
"Algunas zonas peligrosas están marcadas con <w>exclusiones</w>. La exploración\n"
"automática <localtiles>(incluyendo la iniciada mediante un <input>clic del\n"
"ratón</input>!) </localtiles>no se adentrará en una zona de exclusión, sino que\n"
"se detendrá.\n"
"\n"
"Sin embargo, puedes reanudar la exploración automática mediante\n"
"<input>$cmd[CMD_EXPLORE]</input>, y ésta rodeará de forma segura dichas\n"
"exclusiones.\n"

#. key: tutorial1 autoexplore_announce
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial1 autoexplore_announce"
msgid ""
"Autoexplore will stop when you first see items or dungeon features, like these\n"
"stairs. To travel directly to the stairs, you can\n"
"<localtiles><input>click</input> on them; or you can </localtiles>press\n"
"<input>$cmd[CMD_DISPLAY_MAP]</input> to enter the map overview, then\n"
"<input><<</input> to move the cursor to the nearest up-stairs, and\n"
"<input>Enter</input> to go there.\n"
msgstr ""
"La exploración automática se detendrá para anunciar objetos y estructuras del\n"
"calabozo. Para viajar directamente hacia las escaleras, puedes <localtiles>\n"
"<input>hacer clic</input> sobre ellas, o </localtiles>pulsar\n"
"<input>$cmd[CMD_DISPLAY_MAP] << Enter</input>.\n"

#. key: tutorial1 tutorial_end
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial1 tutorial_end"
msgid ""
"Congratulations! You've completed the first lesson!\n"
"\n"
"To exit the tutorial, simply go up these stairs with\n"
"<input>$cmd[CMD_GO_UPSTAIRS]</input><localtiles> or by\n"
"<input>left clicking</input> on your character</localtiles>. Confirm the\n"
"resulting prompt with an uppercase <input>Y</input>.\n"
msgstr ""
"¡Enhorabuena! ¡Has completado tu primera lección!\n"
"\n"
"Para salir del curso, simplemente baja por estas escaleras mediante\n"
"<input>$cmd[CMD_GO_UPSTAIRS]</input><localtiles>, o haciendo\n"
"<input>Shift-clic</input> sobre tu personaje</localtiles>. Responde a la\n"
"pregunta de confirmación con una <input>Y</input> mayúscula.\n"

#. key: tutorial1 newlevel
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial1 newlevel"
msgid ""
"A new level! To begin with, head over to that door to the right.\n"
"\n"
"Also, remember: You can reread old messages with\n"
"<input>$cmd[CMD_REPLAY_MESSAGES]</input>.\n"
msgstr ""
"¡Un nuevo nivel! Para empezar, dirígete hacia esa puerta a la derecha.\n"
"\n"
"Además, recuerda: Puedes volver a leer los mensajes viejos mediante\n"
"<input>$cmd[CMD_REPLAY_MESSAGES]</input>.\n"

#. key: tutorial1 door
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial1 door"
msgid ""
"You can open a closed door by walking into it.\n"
msgstr ""
"Para abrir una puerta cerrada, intenta moverte sobre ella.\n"

#. key: tutorial1 water
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial1 water"
msgid ""
"Note how you can move through shallow but not through deep water.\n"
msgstr ""
"Observa como eres capaz de atravesar las aguas superficiales pero no las\n"
"profundas.\n"

#. key: tutorial1 upstairs
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial1 upstairs"
msgid ""
"When standing on a staircase leading upwards, you can enter the previous level\n"
"with <input>$cmd[CMD_GO_UPSTAIRS]</input><localtiles> or by\n"
"<input>left clicking</input> on your character</localtiles>.\n"
msgstr ""
"Cuando estés sobre unas escaleras ascendentes, puedes volver al nivel previo\n"
"mediante <input>$cmd[CMD_GO_UPSTAIRS]</input><localtiles> o haciendo\n"
"<input>Shift-clic</input> sobre tu personaje</localtiles>.\n"

#. key: tutorial2 start
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 start"
msgid ""
"This lesson will teach you about monsters and fighting. First, we need a\n"
"weapon! Go and grab the one lying over there.\n"
msgstr ""
"En esta lección vas a aprender un poco acerca de los monstruos y el combate. Lo\n"
"primero, ¡necesitamos un arma! Ve y recoge una que está cerca de ti.\n"

#. key: tutorial2 melee
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 melee"
msgid ""
"To attack a monster with your bare hands or wielded weapon, simply walk into\n"
"it.\n"
msgstr ""
"Para atacar a un monstruo con tus puños o con un arma que hayas empuñado\n"
"previamente, simplemente intenta caminar sobre él.\n"

#. key: tutorial2 resting
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 resting"
msgid ""
"Very good! You can heal by resting with <input>$cmd[CMD_REST]</input>\n"
"<localtiles>, or by clicking the 'rest' button in the command bar below the\n"
"minimap</localtiles>. This will make you rest until your health is full, but\n"
"will be interrupted by important events.\n"
msgstr ""
"¡Muy bien! Puedes recuperar cualquier cantidad de puntos de vida que hayas\n"
"perdido descansando con <input>$cmd[CMD_REST]</input>. Este descanso puede\n"
"durar hasta 100 turnos por cada pulsación, pero algunos eventos importantes\n"
"podrían interrumpirlo.\n"

#. key: tutorial2 wait
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 wait"
msgid ""
"Rather than storm the room and get swarmed by monsters, you can also step back\n"
"and wait (with <input>$cmd[CMD_WAIT]</input><localtiles> or by\n"
"<input>clicking</input> on your character</localtiles>) for them to come to you.\n"
msgstr ""
"En lugar de entrar de lleno en la sala, donde podrías verte rodeado de\n"
"monstruos por todas partes, da algunos pasos hacia atrás y espera (con\n"
"<input>$cmd[CMD_WAIT]</input>) a que ellos vengan a ti.\n"

#. key: tutorial2 resting_reminder
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 resting_reminder"
msgid ""
"Remember, you can rest up with <input>$cmd[CMD_REST]</input>.\n"
msgstr ""
"Recuerda, puedes descansar pulsando <input>$cmd[CMD_REST]</input>.\n"

#. key: tutorial2 downstairs
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 downstairs"
msgid ""
"Well done! After resting to full health continue to the next level with\n"
"<input>$cmd[CMD_GO_DOWNSTAIRS]</input><localtiles> or by <input>clicking</input>\n"
"on your character</localtiles>.\n"
msgstr ""
"¡Bien hecho! Después de descansar hasta recuperar todos tus puntos de vida,\n"
"avanza al siguiente nivel mediante\n"

#. key: tutorial2 newlevel
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 newlevel"
msgid ""
"Remember: You can reread old messages with\n"
"<input>$cmd[CMD_REPLAY_MESSAGES]</input>.\n"
msgstr ""
"Recuerda: Puedes volver a leer los mensajes viejos con\n"

#. key: tutorial2 throwing
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 throwing"
msgid ""
"You can fire your boomerangs at a monster with <input>$cmd[CMD_FIRE]</input>\n"
"<localtiles> or by <input>clicking</input> on them in the inventory\n"
"panel</localtiles>. To confirm the auto-targeted monster, press\n"
"<input>$cmd[CMD_TARGET_SELECT]</input> or <input>Enter</input>. You can skip\n"
"this and fire at the closest monster with <input>shift-tab</input> or <input>p</input>.\n"
msgstr ""
"Para lanzarle tus dardos a un monstruo, pulsa <input>$cmd[CMD_FIRE]</input>\n"
"<localtiles> o haz <input>clic</input> sobre tus dardos en el panel de\n"
"inventorio</localtiles>. Confirma el objetivo seleccionado que ha sido\n"
"seleccionado automáticamente, pulsando <input>$cmd[CMD_TARGET_SELECT]</input> o\n"

#. key: tutorial2 wield_bow
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 wield_bow"
msgid ""
"Pick up this shortbow and wield it with <input>$cmd[CMD_EQUIP]</input>\n"
"<localtiles> or by <input>mouseclick</input></localtiles>.\n"
msgstr ""
"Toma este arco y empuñalo con <input>$cmd[CMD_WIELD_WEAPON]</input>\n"
"<localtiles> o haciéndole <input>clic</input> con el ratón</localtiles>.\n"

#. key: tutorial2 travel_reminder
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 travel_reminder"
msgid ""
"Remember that you can autoexplore using <input>$cmd[CMD_EXPLORE]</input>.\n"
msgstr ""
"Recuerda que es posible explorar de forma automatizada usando\n"

#. key: tutorial2 explore
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 explore"
msgid ""
"Find the exit! Remember that you can autoexplore using\n"
"<input>$cmd[CMD_EXPLORE]</input>.\n"
msgstr ""
"¡Encuentra la salida! Recuerda que puedes explorar automáticamente usando\n"
"<input>$cmd[CMD_EXPLORE]</input>.\n"

#. key: tutorial2 tutorial_end
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial2 tutorial_end"
msgid ""
"Congratulations! You've survived your first batch of monsters! To exit the\n"
"tutorial, simply go down these stairs.\n"
msgstr ""
"¡Enhorabuena! ¡Has logrado sobrevivir tu primera banda de monstruos! Para salir\n"
"del curso, simplemente baja esas escaleras.\n"

#. key: tutorial3 start
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 start"
msgid ""
"In this lesson you're going to learn about items and how to use them.\n"
msgstr ""
"En esta lección vas a aprender acerca de los objetos y de como usarlos.\n"

#. key: tutorial3 armour
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 armour"
msgid ""
"Pick up these boots with <input>$cmd[CMD_PICKUP]</input> and wear them with\n"
"<input>$cmd[CMD_EQUIP]</input>.<localtiles> Or simply <input>mouseclick</input>\n"
"on them in the inventory panel.</localtiles>\n"
msgstr ""
"Toma esas botas mediante <input>$cmd[CMD_PICKUP]</input> y póntelas mediante\n"
"<input>$cmd[CMD_WEAR_ARMOUR]</input>.<localtiles> O simplemente haz <input>clic\n"
"con el ratón</input> sobre ellas en el panel de inventario.</localtiles>\n"

#. key: tutorial3 autopickup
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 autopickup"
msgid ""
"Some types of items<tiles>, marked with a green frame,</tiles> are picked up\n"
"automatically as you step on them.\n"
msgstr ""
"Algunos tipos de objetos<tiles>, marcados con un recuadro verde,</tiles> son\n"
"recogidos de forma automática cuando pases por encima de ellos.\n"

#. key: tutorial3 scroll
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 scroll"
msgid ""
"Many items are unidentified when you find them. One way to find out what they\n"
"do is to use them. Try reading this scroll with <input>$cmd[CMD_READ]</input>\n"
"<localtiles> or with <input>mouseclick</input> in the inventory\n"
"panel</localtiles>.\n"
msgstr ""
"Muchos objetos no están identificados al encontrarlos. Una manera de averiguar\n"
"para que sirven es usarlos. Prueba a leer este pergamino con\n"
"<input>$cmd[CMD_READ]</input><localtiles> o haciendo <input>clic con el\n"
"ratón</input> sobre él en el panel de inventario.\n"

#. key: tutorial3 scroll_noautopickup
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 scroll_noautopickup"
msgid ""
"Autopickup does not work if there's a monster around. You can either pick up\n"
"this scroll now with <input>$cmd[CMD_PICKUP]</input><localtiles> or\n"
"<input>clicking</input> on your character,</localtiles> or you can fight the\n"
"nearby enemy and pick it up afterwards.\n"
msgstr ""
"La recolección automática no funcionará si hay algún monstruo alrededor. Tus\n"
"opciones son, o bien tomar el pergamino mediante\n"
"<input>$cmd[CMD_PICKUP]</input><localtiles> o haciendo <input>clic con el\n"
"ratón</input> sobre tu personaje,</localtiles> o bien luchar contra los\n"
"enemigos que haya cerca de ti y recorgerlo después.\n"

#. key: tutorial3 downstairs
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 downstairs"
msgid ""
"Well fought! If necessary, rest up with <input>$cmd[CMD_REST]</input>, then\n"
"continue downwards with <input>$cmd[CMD_GO_DOWNSTAIRS]</input><localtiles> or\n"
"with a <input>click</input> on your character</localtiles>.\n"
msgstr ""
"¡Bien luchado! Si es necesario, descansa con <input>$cmd[CMD_REST]</input>, y\n"
"luego baja por las escaleras con <input>$cmd[CMD_GO_DOWNSTAIRS]</input>\n"
"<localtiles> o haciendo <input>Shift-clic</input> sobre tu\n"
"personaje</localtiles>.\n"

#. key: tutorial3 command_help
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 command_help"
msgid ""
"If the many commands are too confusing, you can also look them up in the\n"
"command help <input>$cmd[CMD_DISPLAY_COMMANDS]</input>. <localtiles>A number of\n"
"commands are also available in the clickable <w>command panel</w> to the right\n"
"of the screen. </localtiles>Rereading old messages with\n"
"<input>$cmd[CMD_REPLAY_MESSAGES]</input> is available as usual.\n"
msgstr ""
"Si te sientes abrumado por tantos comandos, puedes consultarlos en la ayuda de\n"
"comandos <input>$cmd[CMD_DISPLAY_COMMANDS]</input>. <localtiles>Varios de los\n"
"comandos también estan disponibles en el <w>panel de comandos</w> que se\n"
"encuentra a la derecha de la pantalla, y sobre el cual puedes hacer clic.\n"
"</localtiles>Como es habitual, también puedes volver a leer los mensajes\n"
"pasados mediante <input>$cmd[CMD_REPLAY_MESSAGES]</input>.\n"

#. key: tutorial3 potion
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 potion"
msgid ""
"Potions may provide vital healing or useful enchantments, but some have less\n"
"desirable effects. You can quaff this potion with\n"
"<input>$cmd[CMD_QUAFF]</input><localtiles> or with\n"
"<input>mouseclick</input></localtiles> to discover what it does.\n"
msgstr ""
"Para beber una de estas pociones emplea <input>$cmd[CMD_QUAFF]</input>\n"
"<localtiles> o haz <input>clic con el ratón</input></localtiles>.\n"

#. key: tutorial3 wand_fire
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 wand_fire"
msgid ""
"You can evoke a wand with <input>$cmd[CMD_EVOKE]</input><localtiles> or with\n"
"<input>mouseclick</input> in the inventory panel</localtiles>.\n"
msgstr ""
"Puedes evocar varas mediante <input>$cmd[CMD_EVOKE]</input><localtiles> o\n"
"haciendo <input>clic con el ratón</input> en el panel de\n"
"inventario</localtiles>.\n"

#. key: tutorial3 amulet
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 amulet"
msgid ""
"Jewellery is put on with <input>$cmd[CMD_EQUIP]</input><localtiles>\n"
"or with <input>mouseclick</input> in the inventory panel</localtiles>.\n"
msgstr ""
"Para ponerse una pieza de joyería usa <input>$cmd[CMD_WEAR_JEWELLERY]</input>\n"
"<localtiles> o haz <input>clic con el ratón</input> en el panel de\n"
"inventario</localtiles>. La identidad de algunas joyas se desvelará al\n"
"ponérserlas, pero otras requerirán ser identificadas de otra manera.\n"

#. key: tutorial3 drop
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 drop"
msgid ""
"This amulet would be very powerful if your character had a god to worship,\n"
"but here and now, it's useless. You may want to drop it with\n"
"<input>$cmd[CMD_DROP]</input><localtiles> or by\n"
"<input>Shift-leftclicking</input> it in the inventory panel</localtiles>.\n"
msgstr ""
"El amuleto es inútil; quizás quieras tirarlo <input>$cmd[CMD_DROP]</input>\n"
"<localtiles> o mediante <input>Shift-click izquierdo</input> en el\n"
"inventario</localtiles>\n"

#. key: tutorial3 gold
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 gold"
msgid ""
"Gold can be spent in shops. It takes no inventory space and cannot be dropped.\n"
msgstr ""
"Puedes gastar el oro en las tiendas. El oro no pesa y no puede ser depositado.\n"

#. key: tutorial3 shop
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 shop"
msgid ""
"Shops offer a variety of items, but they don't buy items from anyone.\n"
msgstr ""
"Las tiendas venden objetos diversos, pero no comprarán objetos de nadie.\n"

#. key: tutorial3 enter_shop
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 enter_shop"
msgid ""
"To enter this shop, press <input>$cmd[CMD_GO_UPSTAIRS]</input><localtiles> or\n"
"<input>click</input> on your character</localtiles>. To buy items,\n"
"select them with their hotkey, hit <input>Enter</input> and confirm with\n"
"<input>y</input>es. You can switch to description mode with <input>!</input>.\n"
msgstr ""
"Para entrar en esta tienda, presiona <input>$cmd[CMD_GO_UPSTAIRS]</input>\n"
"<localtiles> o <input>Shift Click izquierdo</input> en tu personaje\n"
"</localtiles>. Para comprar objetos, selecciónalos con su atajo, pulsa\n"
"<input>Enter</input> y confirma con <input>y</input>s. Puedes cambiar al modo\n"
"descripción pulsando <input>!</input>.\n"

#. key: tutorial3 autoexplore_reminder
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 autoexplore_reminder"
msgid ""
"Remember, you can explore the level automatically with\n"
"<input>$cmd[CMD_EXPLORE]</input><localtiles> or by <input>clicking</input> the\n"
"autoexplore command button in the <w>command panel</w></localtiles>.\n"
msgstr ""
"Recuerda, puedes explorar automáticamente el nivel con\n"
"<input>$cmd[CMD_EXPLORE]</input><localtiles> o haciendo <input>click</input>\n"
"en el botón de comando \"autoexplorar\" en el <w>panel de comandos</w>\n"
"</localtiles>\n"

#. key: tutorial3 optional_battle
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 optional_battle"
msgid ""
"Warning, this way leads to <lightred>a difficult battle</lightred>. You may\n"
"choose to use what you've learned so far in a fight, or try to reach the other\n"
"exit on the island. Either way, it may be a good idea to do some shopping, if\n"
"you haven't already.\n"
msgstr ""
"Advertencia: esta senda conduce a <lightred>una batalla difícil</lightred>.\n"
"Puedes elegir entre usar lo que has aprendido para combatir, o intentar\n"
"alcanzar la otra salida en la isla. En cualquier caso, es posible que sea una\n"
"buena idea comprar algunos objetos, si no los has comprado todavía.\n"

#. key: tutorial3 tutorial_end
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 tutorial_end"
msgid ""
"Well done! To exit the tutorial, simply go down these stairs.\n"
msgstr ""
"¡Bien hecho! Para salir del curso, simplemente desciende estas escaleras.\n"

#. key: tutorial3 exit
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial3 exit"
msgid ""
":nowrap\n"
"<white>Tutorial 3 summary: Items</white>\n"
"\n"
"<yellow>Item commands</yellow>\n"
"  <input>$cmd[CMD_PICKUP]</input>  pick up an item\n"
"  <input>$cmd[CMD_DROP]</input>  drop an item\n"
"  <input>$cmd[CMD_EQUIP]</input>  equip armour, weapons, and jewellery\n"
"  <input>$cmd[CMD_UNEQUIP]</input>  unequip armour, weapons, and jewellery\n"
"  <input>$cmd[CMD_READ]</input>  read a scroll\n"
"  <input>$cmd[CMD_QUAFF]</input>  quaff a potion\n"
"  <input>$cmd[CMD_EVOKE]</input>  evoke a wand\n"
"\n"
"  Use and (un)equip commands are also available from item descriptions in the inventory menu (<input>$cmd[CMD_DISPLAY_INVENTORY]</input>).<localtiles>\n"
"  And of course, <input>mouseclicks</input> also work.</localtiles>\n"
"\n"
"<yellow>Other</yellow>\n"
"  <input>$cmd[CMD_DISPLAY_COMMANDS]?</input> access the command help\n"
"  <input>$cmd[CMD_EXPLORE]</input>  explore automatically\n"
"  <input>$cmd[CMD_SEARCH_STASHES]</input> search for items/features previously seen<localtiles>\n"
"  Several of these commands can also be executed by clicking in the <w>command panel</w>.</localtiles>\n"
msgstr ""
":nowrap\n"
"<yellow>Comandos para usar objetos</yellow>\n"
"  <input>$cmd[CMD_PICKUP]</input>  recoger un objeto\n"
"  <input>$cmd[CMD_WEAR_ARMOUR]</input>  ponerse una pieza de una armadura\n"
"  <input>$cmd[CMD_READ]</input>  leer un pergamino\n"
"  <input>$cmd[CMD_WIELD_WEAPON]</input>  empuñar un arma\n"
"  <input>$cmd[CMD_QUAFF]</input>  beber una poción\n"
"  <input>$cmd[CMD_EVOKE]</input>  invocar una varita\n"
"  <input>$cmd[CMD_WEAR_JEWELLERY]</input>  ponerse joyería\n"
"  <input>$cmd[CMD_REMOVE_JEWELLERY]</input>  quitarse joyería\n"
"  <input>$cmd[CMD_DROP]</input>  depositar un objeto\n"
"  Los comandos para usar objetos también están disponibles en el menú del inventario (<input>$cmd[CMD_DISPLAY_INVENTORY]</input>), así como las descripciones de los mismos.<localtiles>\n"
"  Y por supuesto, <input>los clics con el ratón</input> también funcionan.</localtiles>\n"
"\n"
"<yellow>Otros comandos</yellow>\n"
"  <input>$cmd[CMD_DISPLAY_COMMANDS]?</input> muestra la ayuda sobre comandos\n"
"  <input>$cmd[CMD_RESISTS_SCREEN]</input>  muestra información acerca del personaje\n"
"  <input>$cmd[CMD_USE_ABILITY]</input>  usar una habilidad\n"
"  <input>$cmd[CMD_EXPLORE]</input>  explorar de forma automatizada\n"
"  <input>$cmd[CMD_SEARCH_STASHES]</input>  buscar objetos o lugares que hayan sido vistos previamente<localtiles>\n"
"  Varios de estos comandos también pueden ser ejecutados cliqueando en el <w>panel de comandos</w>.</localtiles>\n"
"\n"
"                   <cyan>Presiona <input>cualquier tecla</input> para limpiar esta pantalla...</cyan>\n"

#. key: tutorial4 start
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial4 start"
msgid ""
"In this lesson you're going to learn how to memorise and cast spells.\n"
msgstr ""
"En esta lección vas a aprender acerca de como memorizar e invocar hechizos.\n"

#. key: tutorial5 start
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial5 start"
msgid ""
"In this lesson you're going to learn about gods and how to use their powers.\n"
msgstr ""
"En esta lección vas a aprender acerca de los dioses y de como usar sus poderes.\n"

#. key: tutorial5 religion
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial5 religion"
msgid ""
"Have a look at your current religious standing with\n"
"<input>$cmd[CMD_DISPLAY_RELIGION]</input><localtiles> (or via the <w>religion\n"
"button</w> in the command panel, or by <input>Shift-rightclicking</input> on\n"
"the player tile)</localtiles>. Again, pressing <input>!</input><localtiles> or\n"
"<input>rightclicking</input></localtiles> will bring up a more detailed\n"
"description of your god.\n"
msgstr ""
"Échale un vistazo a tu situación religiosa actual mediante\n"
"<input>$cmd[CMD_DISPLAY_RELIGION]</input><localtiles> (o a través del <w>botón\n"
"religión</w> en el panel de comandos, o haciendo <input>Shift-clic con el botón\n"
"derecho</input> en el cuadrado de tu personaje)</localtiles>. Otra vez,\n"
"pulsando <input>!</input><localtiles> o haciendo <input>clic con el botón\n"
"derecho del ratón</input>,</localtiles> verás una descripción más detallada de\n"
"tu dios.\n"

#. key: tutorial5 piety_on_kill
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial5 piety_on_kill"
msgid ""
"Some gods really like it if you kill monsters in their name. Let the slaughter\n"
"begin!\n"
msgstr ""
"Algunos dioses realmente aprecian que mates monstruos en su nombre. ¡Qué\n"
"empiece la masacre!\n"

#. key: tutorial5 berserk
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial5 berserk"
msgid ""
"Against particularly tough foes, you may want to use Trog's Berserk power with\n"
"<input>$cmd[CMD_USE_ABILITY]</input><localtiles> or via the <w>command\n"
"panel</w></localtiles>.\n"
msgstr ""
"Contra enemigos particularmente difíciles, te puede interesar usar el poder de\n"
"Trog Furia mediante <input>$cmd[CMD_USE_ABILITY]</input><localtiles> o a\n"
"través del <w>panel de comandos</w></localtiles>.\n"

#. key: tutorial5 berserk2
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial5 berserk2"
msgid ""
"Berserk is also really useful against multiple enemies — as long as you don't\n"
"run out of steam in-between.\n"
msgstr ""
"Ponerte hecho una furia también es muy útil cuando te enfrentes a varios\n"
"oponentes, siempre que no te quedes exhausto antes de acabar con todos ellos.\n"

#. key: tutorial5 tutorial_end
#: dat/descript/tutorial.txt
msgctxt ""
"textdb:hints:tutorial5 tutorial_end"
msgid ""
"Congratulations! You've finished the last tutorial lesson and are now ready for\n"
"the real game. Good luck!\n"
"\n"
"To exit the tutorial, just go down these stairs.\n"
msgstr ""
"¡Enhorabuena! Has completado la última lección del curso para principiantes y\n"
"ya estás preparado para el juego auténtico. ¡Buena suerte!\n"
"\n"
"Para salir del curso, simplemente desciende estas escaleras.\n"

