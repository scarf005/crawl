"Drop items\n"
msgstr ""
"Gegenstand ablegen\n"

#. key: cmd_drop verbose
#: dat/descript/commands.txt
msgctxt ""
"textdb:descriptions:cmd_drop verbose"
msgid ""
"Drops one or more items that you are currently holding.\n"
msgstr ""
"Lege einen oder mehrere Gegenstände, die du gerade bei dir hast, ab.\n"

#. key: cmd_display_map
#: dat/descript/commands.txt
